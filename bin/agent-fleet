#!/usr/bin/env bash
# agent-fleet — a tmux-native session manager for Claude Code agents.
#
# Model (Phase 1)
# ---------------
#   workspace = a tmux SESSION on the isolated fleet socket (named for a dir)
#   agent     = a tmux WINDOW inside a workspace (one `claude` per window)
#   tab       = the native tmux window tab
#   pane      = a real PTY; an agent owns its window, split for sidecars
#
# Everything runs on a dedicated tmux socket (default: agent-fleet), fully
# isolated from your daily tmux server, config, and keybinds.
#
# The primary surface is a single fzf popup (Prefix o inside the fleet);
# this CLI is the verb layer the popup and your shell call.

set -euo pipefail

# --- Resolve install root (works whether invoked via symlink or direct path) ---
SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_PATH" ]]; do
  SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
  SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
  [[ "$SCRIPT_PATH" != /* ]] && SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
done
BIN_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
ROOT_DIR="$(cd "$BIN_DIR/.." && pwd)"

AGENT_FLEET_VERSION="0.2.0"
# GitHub slug the self-upgrade fetches releases from (override for a fork).
AGENT_FLEET_REPO="${AGENT_FLEET_REPO:-hyb175/agent-fleet}"

CONF="${AGENT_FLEET_CONF:-$ROOT_DIR/conf/agent-fleet.conf}"
SOCKET="${AGENT_FLEET_SOCKET:-agent-fleet}"
DEFAULT_AGENT_CMD="${AGENT_FLEET_CMD:-claude}"
HOME_SESSION="${AGENT_FLEET_HOME_SESSION:-home}"

TMUX_BIN="${TMUX_BIN:-tmux}"
export AGENT_FLEET_ROOT="$ROOT_DIR"
export AGENT_FLEET_SOCKET="$SOCKET"
# The conf's `bind r source-file "$AGENT_FLEET_CONF"` expands this at server
# parse time, so reload keeps honoring a custom-conf override.
export AGENT_FLEET_CONF="$CONF"
# Resolve the palette (AGENT_FLEET_THEME) and render its tmux side before any
# tx call can boot the server — the conf sources $AGENT_FLEET_THEME_CONF at
# parse time.
source "$ROOT_DIR/scripts/theme.sh"
theme_write_conf
tx() { "$TMUX_BIN" -L "$SOCKET" -f "$CONF" "$@"; }

server_up() { tx list-sessions >/dev/null 2>&1; }

# True iff this shell is attached to the fleet's OWN tmux socket.
in_fleet_tmux() {
  [[ -n "${TMUX:-}" ]] && [[ "${TMUX%%,*}" == */"$SOCKET" ]]
}

# Push runtime locations into the server's global env so popup/keybind
# children (display-popup, run-shell) can resolve them.
# NOTE: the claude shim (shims/claude) is injected via the conf's
# default-command (scripts/pane-shell.sh), NOT via the server environment —
# tmux special-cases PATH and pane spawns ignore global/session PATH overrides.
ensure_server_env() {
  tx set-environment -g AGENT_FLEET_ROOT "$ROOT_DIR" 2>/dev/null || true
  tx set-environment -g AGENT_FLEET_SOCKET "$SOCKET" 2>/dev/null || true
  # Rails/pickers spawned by tmux hooks resolve the palette from this; the
  # conf's %if needs THEME_CONF in the server env to re-style on re-parse.
  tx set-environment -g AGENT_FLEET_THEME "$AF_THEME" 2>/dev/null || true
  tx set-environment -g AGENT_FLEET_THEME_CONF "$AGENT_FLEET_THEME_CONF" 2>/dev/null || true
}

# '|' is also mapped: it's the fleet.snapshot field delimiter, so letting it
# into session names would shift every consumer's parse.
sanitize_name() { printf '%s' "$1" | tr ':. /|' '_____'; }

# Socket-scoped cache dir (scripts/cache.sh) — two fleets on different sockets
# used to share one cache dir and could corrupt each other's pane/task/layout
# state (a fresh boot on one socket purging another's live panes, or restore
# resuming another socket's saved agents).
source "$ROOT_DIR/scripts/cache.sh"
source "$ROOT_DIR/scripts/overlay.sh"
AF_TASKS_DIR="$AF_CACHE_DIR/tasks"

# One-time migration of a pre-scoping install's cache layout into the default
# socket's scoped dir (see cache_migrate_default). Gated on no server being up
# on this socket yet: a live server already resolved the old unscoped paths
# for its own lifetime, so migrating under it would split a running fleet's
# state across two layouts instead of upgrading a stopped one.
server_up || cache_migrate_default

# Start the snapshot daemon (single writer the rails/picker read) if not already
# running. Self-deduping, so a stray extra launch just exits.
ensure_snapshotd() {
  local pf="$AF_CACHE_DIR/snapshotd.lock/pid" p
  p="$(cat "$pf" 2>/dev/null || true)"
  # Verify the pid is actually a snapshotd — after an unclean shutdown the pid
  # can be recycled by an unrelated process, and no writer would ever start.
  [[ -n "$p" ]] && kill -0 "$p" 2>/dev/null \
    && ps -p "$p" -o command= 2>/dev/null | grep -q snapshotd && return 0
  AGENT_FLEET_SOCKET="$SOCKET" AGENT_FLEET_ROOT="$ROOT_DIR" \
    nohup "$ROOT_DIR/scripts/snapshotd.sh" >/dev/null 2>&1 &
}

# Federated hosts, newest-wins: AGENT_FLEET_REMOTES (space/comma separated) for
# a one-shot override, else one host per line in the config file ('#' comments).
# Same precedence and location as the theme choice, for the same reason: a
# keybind-fired CLI call runs in the server's environment, where a shell-profile
# export never arrives.
remotes_list() {
  local cfg="${XDG_CONFIG_HOME:-$HOME/.config}/agent-fleet/remotes" line
  if [[ -n "${AGENT_FLEET_REMOTES:-}" ]]; then
    printf '%s\n' "${AGENT_FLEET_REMOTES//,/ }" | tr ' ' '\n' | awk 'NF'
    return 0
  fi
  [[ -r "$cfg" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"; line="${line//[[:space:]]/}"
    [[ -n "$line" ]] && printf '%s\n' "$line"
  done < "$cfg"
}

# One mirror process per configured host. Self-deduping on a per-host pidfile,
# comm-checked the same way as the snapshot daemon: after an unclean shutdown a
# recycled pid would otherwise lock the poller out forever.
ensure_remote_pollers() {
  local host pf p
  while IFS= read -r host; do
    [[ -n "$host" ]] || continue
    pf="$AF_CACHE_DIR/remote/$host.pid"
    p="$(cat "$pf" 2>/dev/null || true)"
    if [[ -n "$p" ]] && kill -0 "$p" 2>/dev/null \
       && ps -p "$p" -o command= 2>/dev/null | grep -q remote-poll; then
      continue
    fi
    mkdir -p "$AF_CACHE_DIR/remote" 2>/dev/null || continue
    AGENT_FLEET_SOCKET="$SOCKET" AGENT_FLEET_ROOT="$ROOT_DIR" \
      nohup "$ROOT_DIR/scripts/remote-poll.sh" "$host" >/dev/null 2>&1 &
    echo $! > "$pf" 2>/dev/null || true
  done < <(remotes_list)
}

# Drop pollers (and their mirrored snapshots) for hosts no longer configured, so
# a removed host stops appearing in the rail instead of lingering as a stale row.
stop_stale_pollers() {
  local pf host keep p
  [[ -d "$AF_CACHE_DIR/remote" ]] || return 0
  keep="$(remotes_list)"
  for pf in "$AF_CACHE_DIR/remote/"*.pid; do
    [[ -e "$pf" ]] || continue
    host="$(basename "$pf" .pid)"
    grep -qxF "$host" <<<"$keep" && continue
    p="$(cat "$pf" 2>/dev/null || true)"
    { [[ -n "$p" ]] && ps -p "$p" -o command= 2>/dev/null | grep -q remote-poll \
        && kill "$p" 2>/dev/null; } || true
    rm -f "$pf" "$AF_CACHE_DIR/remote/$host.snapshot" 2>/dev/null || true
  done
}

# Kill every poller and drop the mirrored snapshots — a stopped fleet must not
# leave an ssh loop running, nor remote rows that nothing is refreshing.
stop_remote_pollers() {
  local pf p
  [[ -d "$AF_CACHE_DIR/remote" ]] || return 0
  for pf in "$AF_CACHE_DIR/remote/"*.pid; do
    [[ -e "$pf" ]] || continue
    p="$(cat "$pf" 2>/dev/null || true)"
    { [[ -n "$p" ]] && ps -p "$p" -o command= 2>/dev/null | grep -q remote-poll \
        && kill "$p" 2>/dev/null; } || true
  done
  rm -f "$AF_CACHE_DIR/remote/"*.pid "$AF_CACHE_DIR/remote/"*.snapshot 2>/dev/null || true
}

# One-time legacy sweep: daemons/pollers started by PRE-SCOPING code keep their
# pidfiles at the cache ROOT. stop/reload must reach them too — otherwise the
# first post-upgrade reload starts a SECOND snapshotd (glyph/progress fights)
# and orphaned ssh pollers outlive the fleet, writing snapshots nobody reads.
legacy_daemon_sweep() {
  local p pf
  p="$(cat "$AF_CACHE_ROOT/snapshotd.lock/pid" 2>/dev/null || true)"
  if [[ -n "$p" ]] && ps -p "$p" -o command= 2>/dev/null | grep -q snapshotd; then
    kill "$p" 2>/dev/null || true
  fi
  for pf in "$AF_CACHE_ROOT"/remote/*.pid; do
    [[ -e "$pf" ]] || continue
    p="$(cat "$pf" 2>/dev/null || true)"
    { [[ -n "$p" ]] && ps -p "$p" -o command= 2>/dev/null | grep -q remote-poll \
        && kill "$p" 2>/dev/null; } || true
  done
  rm -rf "$AF_CACHE_ROOT/remote" "$AF_CACHE_ROOT/snapshotd.lock" 2>/dev/null || true
}

# A federated target is "<host>/<id>", or a bare "<host>" — the row a down host
# collapses to carries no id. Either way <host> must be a CONFIGURED remote.
# sanitize_name maps '/' out of session names, so no qualified local target can
# be shadowed; an unconfigured prefix stays a plain local name.
remote_host_of() {  # <target> -> host, or non-zero
  local h="${1%%/*}"
  [[ -n "$h" ]] || return 1
  remotes_list | grep -qxF "$h" || return 1
  printf '%s' "$h"
}

# The part of a federated target after the host ("" for a bare host).
remote_id_of() {  # <target> <host>
  local id="${1#"$2"}"
  printf '%s' "${id#/}"
}

# Jump to a federated target by opening a tab that ssh's into its host, where
# the remote fleet attaches at that pane/workspace. The remote fleet then runs
# NESTED in this pane, so its prefix needs a double tap — the alternative,
# driving the remote non-interactively, leaves nowhere to actually type.
remote_hop() {  # <host> <remote id>
  # Same ssh seam as remote-poll.sh: a stub stands in for ssh so the suite never
  # touches a network.
  local host="$1" id="$2" ssh_cmd="${AGENT_FLEET_SSH_CMD:-ssh}" inner cmd win
  # No id (a down host's row) — attach to whatever that fleet is showing.
  if [[ -z "$id" ]]; then
    inner="agent-fleet attach"
  elif [[ "$id" == %* ]]; then
    printf -v inner 'agent-fleet goto %q' "$id"
  else
    printf -v inner 'agent-fleet attach %q' "$id"
  fi
  # A bare interactive shell has nothing to put a tab in — become the ssh.
  # Keybinds and rail clicks have no tty on stdout and land in the else branch.
  if [[ -z "${TMUX:-}" && -t 1 ]]; then
    exec "$ssh_cmd" -t "$host" bash -lc "$inner"
  fi
  printf -v cmd '%q -t %q bash -lc %q' "$ssh_cmd" "$host" "$inner"
  win="$(tx new-window -P -F '#{window_id}' -n "$host" "$cmd" 2>/dev/null)"
  [[ -n "$win" ]] && tx select-window -t "$win" 2>/dev/null || true
}

# Guarantee a server exists with at least one session to attach to.
ensure_server() {
  if ! server_up; then
    # Fresh server: pane ids restart at %0, so per-pane state files from the
    # previous boot are stale (a leftover .session gate file would block the
    # hook from capturing new session ids). persist-restore purges too, but
    # this also covers the no-state fresh-boot path.
    rm -f "$AF_CACHE_DIR/panes/"*.status "$AF_CACHE_DIR/panes/"*.ackdone "$AF_CACHE_DIR/panes/"*.session "$AF_CACHE_DIR/panes/"*.task 2>/dev/null || true
    # Cold boot (e.g. after a reboot): rebuild the last saved layout as shells if
    # we have one; otherwise start a fresh home workspace.
    local rc=1
    if [[ -f "$AF_CACHE_DIR/fleet.state" ]]; then
      rc=0; "$ROOT_DIR/scripts/persist-restore.sh" 2>/dev/null || rc=$?
    fi
    if (( rc != 0 )); then
      # rc 3 = the state belongs to a different socket (see persist-restore).
      # Say so: otherwise a renamed socket looks like the fleet lost its layout.
      (( rc == 3 )) && echo "agent-fleet: saved layout belongs to another tmux socket — starting fresh on '$SOCKET'" >&2
      tx new-session -d -s "$HOME_SESSION" -c "$HOME"
    fi
  fi
  ensure_server_env
  ensure_snapshotd
  ensure_remote_pollers
}

# Generate the fleet-scoped Claude settings file (hooks only). Launching an
# agent as `claude --settings <this>` overlays the status hooks on top of the
# user's global config without touching ~/.claude/settings.json. JSON emission
# lives in scripts/overlay.sh (shared with persist-restore).
ensure_hook_settings() {
  mkdir -p "$AF_CACHE_DIR/panes"
  local f="$AF_CACHE_DIR/hooks-settings.json"
  overlay_write_hooks "$f" "$ROOT_DIR/scripts/agent-status-hook.sh" "$SOCKET"
  printf '%s' "$f"
}

# Sandbox-rung overlay: hooks + OS bash sandbox, writes scoped to one
# root — see scripts/overlay.sh for the emission and the failIfUnavailable
# rationale. Keyed by BOTH cksum fields (CRC + length): a bare CRC-32
# collision would scope one task's writes to another task's worktree.
ensure_sandbox_settings() {  # <write-root> -> prints the overlay path
  local root="$1" key f
  mkdir -p "$AF_CACHE_DIR/panes"
  key="$(printf '%s' "$root" | cksum | awk '{print $1"-"$2}')"
  f="$AF_CACHE_DIR/sandbox-$key.json"
  overlay_write_sandbox "$f" "$ROOT_DIR/scripts/agent-status-hook.sh" "$SOCKET" "$root"
  printf '%s' "$f"
}

# ---- task records ------------------------------------------------------------
# A task is the durable record of an agent's INTENT — it outlives the pane and
# the fleet server. One key-value file per task under $AF_TASKS_DIR, with an
# append-only `state <name> <epoch>` history (written by agent-status-hook.sh
# on transitions). The pane carries the id twice: a @fleet-task pane option
# (persist-save reads it via a format string) and a panes/<pane>.task pointer
# file (the status hook resolves it without a tmux call).
task_record_create() {  # <pane_id> <intent> <dir> <kind> -> prints the task id
  local pane="$1" intent="$2" dir="$3" kind="$4" tid now
  printf -v now '%(%s)T' -1
  # Pane ids are unique on a live server, so epoch + pane number can't collide.
  tid="t$now-${pane#%}"
  mkdir -p "$AF_TASKS_DIR" "$AF_CACHE_DIR/panes" 2>/dev/null || return 0
  # The record is line-oriented: a newline (or CR) smuggled into any value
  # would forge record lines, so flatten them in every field. Tabs too — the
  # snapshot's consumers use tab-delimited sort keys and tty-width renders.
  intent="${intent//[$'\n\r\t']/ }"; dir="${dir//[$'\n\r\t']/ }"; kind="${kind//[$'\n\r\t']/ }"
  {
    printf 'id %s\n'      "$tid"
    printf 'intent %s\n'  "$intent"
    printf 'dir %s\n'     "$dir"
    printf 'kind %s\n'    "$kind"
    printf 'created %s\n' "$now"
    printf 'pane %s\n'    "$pane"
  } > "$AF_TASKS_DIR/$tid" 2>/dev/null || return 0
  # Pointer write is the atomic claim (noclobber): the hook's auto-adopt
  # races this on hand-started agents — first writer wins, the loser
  # reuses the winner's record instead of leaving a permanent orphan.
  local ptr="$AF_CACHE_DIR/panes/$pane.task" cur=""
  if ! (set -C; printf '%s\n' "$tid" > "$ptr") 2>/dev/null; then
    cur="$(cat "$ptr" 2>/dev/null || true)"
    if [[ -n "$cur" && -f "$AF_TASKS_DIR/$cur" ]]; then
      rm -f "$AF_TASKS_DIR/$tid" 2>/dev/null || true
      printf '%s' "$cur"
      return 0
    fi
    # Stale pointer (no record behind it): take it over.
    printf '%s\n' "$tid" > "$ptr" 2>/dev/null || true
  fi
  tx set-option -p -t "$pane" @fleet-task "$tid" 2>/dev/null || true
  printf '%s' "$tid"
}

# Worktree-per-task: a branch + worktree per task, so parallel agents on
# one repo can't collide in a single checkout. Worktrees live OUTSIDE the repo
# at a predictable spot: $XDG_STATE_HOME/agent-fleet/worktrees/<repo>-<hash>/
# <slug> (the 4-digit path hash keeps same-named repos apart). State dir, not
# cache: a cache is deletable by contract, and these hold real work.
AF_WORKTREES_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/agent-fleet/worktrees"

task_worktree_create() {  # <repo-dir> <slug> -> "path<TAB>branch" (empty = degrade)
  local dir="$1" slug="$2" base hash root branch path n=1
  git -C "$dir" rev-parse --git-dir >/dev/null 2>&1 || return 0
  # Sanitize the slug like the repo base: --name is user text, and a '/' in
  # it would nest the worktree below task_orphans' scan depth (an invalid ref
  # would just degrade to the shared checkout with a misleading note).
  slug="${slug//[^A-Za-z0-9._-]/_}"; [[ -n "$slug" ]] || slug="task"
  base="$(basename "$dir")"; base="${base//[^A-Za-z0-9._-]/_}"
  hash="$(printf '%s' "$dir" | cksum | awk '{printf "%04d", $1 % 10000}')"
  root="$AF_WORKTREES_DIR/$base-$hash"
  # A registered-but-deleted worktree with the same path would fail the add;
  # prune first so leftovers from hand-rm'd trees can't block creation.
  git -C "$dir" worktree prune >/dev/null 2>&1 || true
  branch="af/task/$slug"; path="$root/$slug"
  # Suffix past collisions: an existing branch OR a leftover dir both count.
  while git -C "$dir" show-ref --verify --quiet "refs/heads/$branch" 2>/dev/null \
        || [[ -e "$path" ]]; do
    n=$(( n + 1 )); branch="af/task/$slug-$n"; path="$root/$slug-$n"
  done
  mkdir -p "$root" 2>/dev/null || return 0
  # Keep git's own words on failure — "not a git repo" was a lie for the
  # race/invalid-ref cases, and the user is about to run UNisolated.
  local err=""
  err="$(git -C "$dir" worktree add -b "$branch" "$path" 2>&1 >/dev/null)" \
    || { echo "note: worktree add failed: ${err%%$'\n'*}" >&2; return 0; }
  printf '%s\t%s' "$path" "$branch"
}

# ---- isolation ladder --------------------------------------------------
# host < worktree < sandbox < container: each rung includes the previous ones'
# guarantees. Resolution: --isolation flag > AGENT_FLEET_ISOLATION (legacy
# AGENT_FLEET_TASK_ISOLATED=1 = worktree) > <repo>/.agent-fleet 'isolation'
# line > ~/.config/agent-fleet/isolation > host.
resolve_isolation() {  # <repo-dir> <flag-rung> -> prints a valid rung
  local dir="$1" flag="${2:-}" r=""
  if [[ -n "$flag" ]]; then r="$flag"
  elif [[ -n "${AGENT_FLEET_ISOLATION:-}" ]]; then r="$AGENT_FLEET_ISOLATION"
  elif [[ "${AGENT_FLEET_TASK_ISOLATED:-}" == "1" ]]; then r="worktree"
  else
    if [[ -r "$dir/.agent-fleet" ]]; then
      r="$(awk '$1=="isolation"{print $2; exit}' "$dir/.agent-fleet" 2>/dev/null || true)"
    fi
    if [[ -z "$r" ]]; then
      local gf="${XDG_CONFIG_HOME:-$HOME/.config}/agent-fleet/isolation"
      if [[ -r "$gf" ]]; then { read -r r < "$gf"; } 2>/dev/null || true; fi
    fi
  fi
  case "$r" in
    host|worktree|sandbox|container) ;;
    "") r="host" ;;
    *)  echo "note: unknown isolation rung '$r' — running at host" >&2; r="host" ;;
  esac
  printf '%s' "$r"
}

# The sandbox rung needs an OS sandbox for claude's bash: Seatbelt ships with
# macOS; Linux needs bubblewrap AND socat on PATH (claude's network proxy).
sandbox_available() {
  case "$(uname -s)" in
    Darwin) command -v sandbox-exec >/dev/null 2>&1 ;;
    *)      command -v bwrap >/dev/null 2>&1 && command -v socat >/dev/null 2>&1 ;;
  esac
}

# The container rung needs the docker CLI AND a live daemon. timeout
# where available: a wedged daemon would otherwise hang every `af task`.
container_available() {
  command -v docker >/dev/null 2>&1 || return 1
  if command -v timeout >/dev/null 2>&1; then timeout 5 docker info >/dev/null 2>&1
  else docker info >/dev/null 2>&1
  fi
}

# task_container_stop <tid> — stop the task's container(s). Default-image
# tasks record a `container <name>`; devcontainer tasks record a
# `containerdir <dir>` (the devcontainer CLI names its own containers but
# labels them with the workspace folder). --rm reaps the named one; the
# devcontainer CLI's containers stay for reuse, stopped. Never fails caller.
task_container_stop() {
  command -v docker >/dev/null 2>&1 || return 0
  local cn cdir ids
  # LAST container line wins: a restore-resume appends a fresh name.
  cn="$(awk '$1=="container"{v=$2} END{print v}' "$AF_TASKS_DIR/$1" 2>/dev/null || true)"
  [[ -n "$cn" ]] && docker stop -t 2 "$cn" >/dev/null 2>&1 || true
  cdir="$(awk '$1=="containerdir"{sub(/^containerdir /,""); print; exit}' "$AF_TASKS_DIR/$1" 2>/dev/null || true)"
  if [[ -n "$cdir" ]]; then
    ids="$(docker ps -q --filter "label=devcontainer.local_folder=$cdir" 2>/dev/null || true)"
    # shellcheck disable=SC2086 # ids are docker's own newline-separated hashes
    [[ -n "$ids" ]] && docker stop -t 2 $ids >/dev/null 2>&1 || true
  fi
  return 0
}

# build_container_cmd <name> <dir> <repo_dir> <wt_path> <agent_tail> — build
# the container window command, shared by task creation and restore's
# _container-resume. Sets CCMD (the command), CNAME (docker name; empty
# on the devcontainer path) and CDIR_REC (devcontainer workspace to record).
# The string runs under the user's default-shell — keep it fish/sh-compatible:
# no $( ), no arrays, plain "quoted" expansions only.
build_container_cmd() {
  local name="$1" dir="$2" repo_dir="$3" wt_path="$4" agent_tail="$5"
  local _cnow _cn
  CCMD=""; CNAME=""; CDIR_REC=""
  printf -v _cnow '%(%s)T' -1
  # Docker name charset is [A-Za-z0-9_.-]; --name is raw user text and the
  # socket is env-controlled — a space would break the ccmd parse AND the
  # whitespace-split record line task_container_stop reads.
  _cn="$(printf '%s' "${SOCKET}-${name}" | tr -c 'A-Za-z0-9_.-' '_')"
  CNAME="af-${_cn}-${_cnow}"
  if [[ -f "$repo_dir/.devcontainer/devcontainer.json" || -f "$repo_dir/.devcontainer.json" ]] \
     && command -v devcontainer >/dev/null 2>&1; then
    # Repo devcontainer: its config owns the environment (no firewall
    # promise from us). Cache+scripts ride in so the status hooks work; the
    # parent .git so the worktree's absolute-path .git file resolves (the
    # handback); ~/.claude + the OAuth token so the agent is logged in.
    CCMD="devcontainer up --workspace-folder \"$dir\""
    CCMD+=" --mount \"type=bind,source=$AF_CACHE_DIR,target=$AF_CACHE_DIR\""
    CCMD+=" --mount \"type=bind,source=$ROOT_DIR/scripts,target=$ROOT_DIR/scripts\""
    [[ -n "$wt_path" && -d "$repo_dir/.git" ]] \
      && CCMD+=" --mount \"type=bind,source=$repo_dir/.git,target=$repo_dir/.git\""
    [[ -d "$HOME/.claude" ]] \
      && CCMD+=" --mount \"type=bind,source=$HOME/.claude,target=$HOME/.claude\""
    CCMD+=" && exec devcontainer exec --workspace-folder \"$dir\""
    CCMD+=" env TMUX_PANE=\"\$TMUX_PANE\" AGENT_FLEET_SOCKET=\"$SOCKET\""
    CCMD+=" CLAUDE_CODE_OAUTH_TOKEN=\"\$CLAUDE_CODE_OAUTH_TOKEN\""
    [[ -n "${XDG_CACHE_HOME:-}" ]] && CCMD+=" XDG_CACHE_HOME=\"$XDG_CACHE_HOME\""
    CCMD+=" $agent_tail"
    # The devcontainer CLI names its own container but labels it with the
    # workspace folder — record that so terminal marks can stop it.
    CNAME=""; CDIR_REC="$dir"
  else
    [[ -f "$repo_dir/.devcontainer/devcontainer.json" || -f "$repo_dir/.devcontainer.json" ]] \
      && echo "note: repo has a devcontainer but the devcontainer CLI is missing — using the default image" >&2
    local vols envs img imgver
    vols="-v \"$dir:$dir\""
    [[ -n "$wt_path" && -d "$repo_dir/.git" ]] && vols+=" -v \"$repo_dir/.git:$repo_dir/.git\""
    vols+=" -v \"$AF_CACHE_DIR:$AF_CACHE_DIR\" -v \"$ROOT_DIR/scripts:$ROOT_DIR/scripts:ro\""
    [[ -d "$HOME/.claude" ]] && vols+=" -v \"$HOME/.claude:$HOME/.claude\""
    envs="-e TMUX_PANE -e AF_TASK_PROMPT -e HOME -e CLAUDE_CODE_OAUTH_TOKEN"
    envs+=" -e AGENT_FLEET_SOCKET=\"$SOCKET\" -e AF_UID=$(id -u) -e AF_GID=$(id -g)"
    [[ -n "${XDG_CACHE_HOME:-}" ]] && envs+=" -e XDG_CACHE_HOME=\"$XDG_CACHE_HOME\""
    # Content-keyed tag: editing docker/ (a new allowlist host, say) must
    # take effect on the next task, not stay frozen at the first build.
    imgver="$(cat "$ROOT_DIR/docker"/* 2>/dev/null | cksum | awk '{print $1}')"
    img="af-default:v${imgver:-0}"
    # Build in the PANE (progress visible; a failure is a visible dead pane,
    # not a silent degrade). NET_ADMIN: the image's default-deny firewall.
    # --init: claude is the container's PID 1 otherwise, and its subshells'
    # orphans would accumulate as zombies over a long session.
    CCMD="docker image inspect $img >/dev/null 2>&1"
    CCMD+=" || docker build -t $img \"$ROOT_DIR/docker\" || exit 1; "
    CCMD+="exec docker run --rm -it --init --name \"$CNAME\" --cap-add NET_ADMIN"
    CCMD+=" $envs $vols -w \"$dir\" $img $agent_tail"
  fi
}

# task_id_for <id|%pane> — resolve either form to a task id, or fail.
task_id_for() {
  local arg="$1" tid="$1"
  if [[ "$arg" == %* ]]; then
    tid="$(cat "$AF_CACHE_DIR/panes/$arg.task" 2>/dev/null || true)"
    if [[ -z "$tid" ]]; then
      # Dead pane: gc pruned the pointer but the record survives — scan records
      # for the pane, keeping the NEWEST match (ids sort by creation epoch;
      # a recycled pane number can appear in several historical records).
      local f match=""
      for f in "$AF_TASKS_DIR"/t*; do
        [[ -e "$f" ]] || continue
        case "$f" in *.tmp.*) continue ;; esac
        grep -qx "pane $arg" "$f" 2>/dev/null && match="$f"
      done
      [[ -n "$match" ]] && tid="$(basename "$match")"
    fi
    [[ -n "$tid" ]] || { echo "error: no task record for pane $arg" >&2; return 1; }
  fi
  [[ -f "$AF_TASKS_DIR/$tid" ]] || { echo "error: no such task: $tid" >&2; return 1; }
  printf '%s' "$tid"
}

# The current session / window id, resolved from the calling pane (in-fleet).
current_session() { [[ -n "${TMUX_PANE:-}" ]] && tx display-message -p -t "$TMUX_PANE" '#S' 2>/dev/null; }
current_window()  { [[ -n "${TMUX_PANE:-}" ]] && tx display-message -p -t "$TMUX_PANE" '#{window_id}' 2>/dev/null; }

# Switch the fleet client to a target, or attach if we're in a bare shell.
# Refuses to hijack a foreign tmux server.
# All session-name targets below use tmux's '=' exact-match prefix: without
# it tmux prefix-matches, so `connect api` with only api-v2 running would
# silently switch to (or kill, or add into) api-v2.
go_to_session() {
  local target="$1"
  if in_fleet_tmux; then
    tx switch-client -t "=$target"
  elif [[ -n "${TMUX:-}" ]]; then
    echo "error: you're inside a different tmux server" >&2
    echo "       detach (Prefix-d) and run \`agent-fleet attach $target\` from a plain shell" >&2
    exit 1
  else
    exec "$TMUX_BIN" -L "$SOCKET" -f "$CONF" attach-session -t "=$target"
  fi
}

# ---- subcommands -------------------------------------------------------------

# connect <dir|name> — resolve-or-create a workspace, then go to it.
#   - existing session name  -> switch to it
#   - a directory path       -> session named for its basename, cwd there
#   - any other name         -> session with that name, cwd $HOME
cmd_connect() {
  local arg="${1:-$PWD}" custom="${2:-}" rhost

  # Existing session by that name → just switch (skip when forcing a new name).
  if [[ -z "$custom" ]] && server_up && tx has-session -t "=$arg" 2>/dev/null; then
    ensure_server_env
    go_to_session "$arg"
    return 0
  fi

  # A federated workspace lives on another machine — hop to it over ssh rather
  # than creating a local session named after it. Checked after the local
  # session and the directory, so neither is ever shadowed by a remote's name.
  if [[ -z "$custom" && ! -d "$arg" ]] && rhost="$(remote_host_of "$arg")"; then
    remote_hop "$rhost" "$(remote_id_of "$arg" "$rhost")"
    return 0
  fi

  local name dir
  if [[ -d "$arg" ]]; then
    dir="$(cd "$arg" && pwd)"
    name="$(sanitize_name "${custom:-$(basename "$dir")}")"
  else
    name="$(sanitize_name "${custom:-$arg}")"
    dir="$HOME"
  fi

  # Opening a workspace here counts as visiting the dir: without this, a dir
  # only entered through the fleet (never a manual cd) stays invisible to
  # zoxide and thus to the picker's frecency ranking.
  [[ "$dir" != "$HOME" ]] && command -v zoxide >/dev/null 2>&1 && zoxide add "$dir" 2>/dev/null || true

  # new-session auto-starts the server if needed; no stray home session.
  if ! tx has-session -t "=$name" 2>/dev/null; then
    tx new-session -d -s "$name" -c "$dir"
  fi
  ensure_server_env
  go_to_session "$name"
}

# add [name] — add an agent window to a workspace.
#   --to <session>          target workspace (default: current fleet session, else first)
#   --new-workspace <name>  put the agent in its own workspace <name> (create or reuse)
#   --cmd <command>         what to run     (default: $AGENT_FLEET_CMD = claude)
#   --dir <dir>             working dir      (default: target session's path, else $PWD)
# Prints the new pane id on success.
usage_add() {
  cat <<EOF
Usage: agent-fleet add [name] [options]

Add an agent window to a workspace and print its pane id.

Options:
  --to <workspace>          Target workspace (default: current fleet workspace, else first).
  --new-workspace <name>    Put the agent in its own workspace (create or reuse).
  --cmd <command>           Command to run (default: $DEFAULT_AGENT_CMD).
  --dir <dir>               Working directory (default: target workspace path, else current directory).
  --intent <text>           What this agent is for — recorded in its task record
                            (default: the agent's name). \`agent-fleet task\` sets it.
  --env <NAME=VALUE>        Set one variable in the window's environment (via tmux,
                            bypassing the shell — safe for arbitrary text).
  --sandbox <root>          claude-only: launch with the OS bash sandbox overlay,
                            filesystem writes scoped to <root> (\`task --isolation
                            sandbox\` uses this; see task -h for the ladder).
  --focus                    Focus the new agent window.
  -h, --help                 Show this help.
EOF
}

cmd_add() {
  local name="" target="" cmd="$DEFAULT_AGENT_CMD" dir="" focus="" new_ws="" intent="" env_kv="" sb_root="" kind_override=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)         usage_add; return 0 ;;
      --to)             target="$2"; shift 2 ;;
      --cmd)            cmd="$2"; shift 2 ;;
      --dir)            dir="$2"; shift 2 ;;
      --new-workspace)  new_ws="$2"; shift 2 ;;
      --intent)         intent="$2"; shift 2 ;;
      --env)            env_kv="$2"; shift 2 ;;
      --sandbox)        sb_root="$2"; shift 2 ;;   # claude-only: sandbox overlay, writes scoped here
      --kind)           kind_override="$2"; shift 2 ;;  # record/tag this agent kind when the
                                                        # command wraps it (docker run … claude)
      --focus)          focus=1; shift ;;
      --)               shift; break ;;
      *)     if [[ -z "$name" ]]; then name="$1"; else echo "error: unexpected arg: $1" >&2; exit 2; fi; shift ;;
    esac
  done

  if ! server_up; then
    echo "error: no fleet running — connect a workspace first" >&2
    exit 1
  fi
  ensure_server_env

  # --new-workspace: put the agent in its own workspace (a new session of that
  # name, or an existing one) rather than a tab in the current one.
  local ph_win=""
  if [[ -n "$new_ws" ]]; then
    new_ws="$(sanitize_name "$new_ws")"
    local wsdir="$dir"
    if [[ -z "$wsdir" ]]; then
      # From inside the fleet, the CALLING pane's cwd; a targetless
      # display-message resolves against some arbitrary recently-active pane.
      # From a bare shell, the caller's $PWD.
      if in_fleet_tmux && [[ -n "${TMUX_PANE:-}" ]]; then
        wsdir="$(tx display-message -p -t "$TMUX_PANE" '#{pane_current_path}' 2>/dev/null || echo "$PWD")"
      else
        wsdir="$PWD"
      fi
    fi
    if ! tx has-session -t "=$new_ws" 2>/dev/null; then
      # Fresh session: its placeholder window is removed after the agent lands
      # (below), so the agent becomes the workspace's first tab — no stray shell.
      ph_win="$(tx new-session -d -P -F '#{window_id}' -s "$new_ws" -c "$wsdir" 2>/dev/null)"
    fi
    target="$new_ws"
    [[ -z "$dir" ]] && dir="$wsdir"
  fi

  if [[ -z "$target" ]]; then
    if in_fleet_tmux; then
      target="$(tx display-message -p '#S')"
    else
      target="$(tx list-sessions -F '#{session_name}' 2>/dev/null | head -1)"
    fi
  fi
  if [[ -z "$target" ]] || ! tx has-session -t "=$target" 2>/dev/null; then
    echo "error: no such workspace: ${target:-<none>}" >&2
    exit 1
  fi

  if [[ -z "$dir" ]]; then
    # "=$target:" (with colon): display-message needs a pane-typed target, and
    # a bare "=name" doesn't coerce — it expands to empty instead of erroring.
    dir="$(tx display-message -p -t "=$target:" '#{pane_current_path}' 2>/dev/null || echo "$PWD")"
    [[ -z "$dir" ]] && dir="$PWD"
  fi
  # Default the agent name to its workspace, so it reads "<workspace> · claude"
  # and follows the workspace on rename. Multiple agents per workspace is fine.
  [[ -z "$name" ]] && name="$target"

  # Fleet usage feeds zoxide frecency (see cmd_connect).
  [[ -n "$dir" && "$dir" != "$HOME" ]] && command -v zoxide >/dev/null 2>&1 && zoxide add "$dir" 2>/dev/null || true

  # Label for the sidenav's agents list (first word of the command). Computed
  # from the *inner* command, before any hook wrapping.
  local label
  label="$(basename "${cmd%% *}")"

  # --sandbox is claude-only (the overlay is claude's settings format); a
  # silent no-op here would launch unisolated while the caller assumes sandbox.
  if [[ -n "$sb_root" && "$label" != "claude" ]]; then
    echo "warning: --sandbox is claude-only — ignored for '$label'" >&2
    sb_root=""
  fi
  if [[ -n "$sb_root" && "$sb_root" == *[[:cntrl:]]* ]]; then
    echo "warning: control characters in the sandbox root — launching hooks-only (no sandbox)" >&2
    sb_root=""
  fi

  if [[ "$label" == "claude" ]]; then
    # Local claude agent: overlay the fleet status hooks. Gate on the command
    # BASENAME being claude — the hooks (and the --settings flag itself) are
    # claude-specific, so a non-claude AGENT_FLEET_CMD (codex, opencode, …)
    # must not get the overlay. Any other command runs verbatim (no hooks).
    # The flag goes right after the binary, ahead of any positional prompt
    # (`agent-fleet task` appends one) — never trailing, where a variadic
    # prompt could swallow it.
    local hooks_file
    if [[ -n "$sb_root" ]]; then
      hooks_file="$(ensure_sandbox_settings "$sb_root")"   # hooks + sandbox superset
    else
      hooks_file="$(ensure_hook_settings)"
    fi
    if [[ "$cmd" == *" "* ]]; then
      cmd="${cmd%% *} --settings '$hooks_file' ${cmd#* }"
    else
      cmd="$cmd --settings '$hooks_file'"
    fi
  fi

  # --env NAME=VALUE lands in the window's environment via tmux itself, so the
  # value never passes through the default-shell parse of the window command —
  # the only quoting-proof way to hand an agent arbitrary text (see cmd_task).
  local pane_id
  # AF_TASK_PRESPAWNED: this spawn writes its own record below — the status
  # hook's auto-adopt must not race it with a duplicate.
  pane_id="$(tx new-window -P -F '#{pane_id}' -e AF_TASK_PRESPAWNED=1 ${env_kv:+-e "$env_kv"} -t "=$target:" -n "$(sanitize_name "$name")" -c "$dir" "$cmd")"
  # Mark the agent so the sidenav lists it (per-pane, focus-independent) and so
  # workspace renames can follow it (per-window). Value = agent kind ("claude");
  # --kind overrides when the command wraps the agent (docker run … claude —
  # basename would say "docker" and restore would relaunch the wrong thing).
  local disp_kind="${kind_override:-$label}"
  tx set-option -p -t "$pane_id" @fleet-agent-kind "$disp_kind" 2>/dev/null || true
  tx set-option -w -t "$pane_id" @fleet-agent "$disp_kind" 2>/dev/null || true
  # Every agent gets a task record; without an explicit intent the name stands in.
  task_record_create "$pane_id" "${intent:-$name}" "$dir" "$disp_kind" >/dev/null || true
  # Drop the placeholder window if we created the workspace for this agent, so the
  # agent is the workspace's first tab.
  [[ -n "$ph_win" ]] && tx kill-window -t "$ph_win" 2>/dev/null || true
  # Quick-add from a keybind wants to land on the new agent (switching workspace
  # first when the agent went into a new one). NOT go_to_session: that execs
  # attach from a bare shell and exits from a foreign tmux, either way eating
  # the pane id we still owe the caller.
  if [[ -n "$focus" ]]; then
    if [[ -n "$new_ws" ]] && in_fleet_tmux; then
      tx switch-client -t "=$new_ws" 2>/dev/null || true
    fi
    tx select-window -t "$pane_id" 2>/dev/null || true
  fi
  echo "$pane_id"
}

# goto <pane_id> — used by the picker: focus the exact agent pane.
cmd_goto() {
  local pane="${1:?usage: agent-fleet goto <pane_id>}"
  local loc sess winid rhost
  if rhost="$(remote_host_of "$pane")"; then
    remote_hop "$rhost" "$(remote_id_of "$pane" "$rhost")"
    return 0
  fi
  loc="$(tx list-panes -a -F '#{pane_id} #{session_name} #{window_id}' 2>/dev/null \
        | awk -v p="$pane" '$1==p {print $2, $3; exit}')"
  if [[ -z "$loc" ]]; then
    echo "error: no such pane: $pane" >&2
    exit 1
  fi
  sess="${loc%% *}"
  winid="${loc##* }"
  # Visiting a finished agent clears its 'done' badge back to idle.
  "$ROOT_DIR/scripts/status.sh" clear-done "$pane" 2>/dev/null || true
  # Select server-side BEFORE switching: from a bare shell go_to_session execs
  # attach-session, so nothing after it runs — and that's exactly the path
  # `ssh -t <host> agent-fleet goto <pane>` takes for a federated jump.
  tx select-window -t "$winid" 2>/dev/null || true
  tx select-pane -t "$pane" 2>/dev/null || true
  go_to_session "$sess"
}

# back — jump to the previously focused pane (Prefix Tab). The focus-in hook
# keeps focus.prev current, so this just resolves and focuses it; landing there
# makes it the new "current", so pressing again toggles between the two.
cmd_back() {
  local prev_file="$AF_CACHE_DIR/focus.prev" p=""
  # || true: an empty/truncating prev file fails the read, and under set -e
  # that silently kills the whole keybind.
  { [[ -f "$prev_file" ]] && read -r p < "$prev_file" 2>/dev/null; } || true
  [[ -z "$p" ]] && exit 0
  # No-op silently if that pane is gone (don't error in a keybind).
  tx list-panes -a -F '#{pane_id}' 2>/dev/null | grep -qx "$p" || exit 0
  cmd_goto "$p"
}

# attach [target] — sesh-style 3-way branch.
cmd_attach() {
  local target="${1:-}"
  ensure_server
  if [[ -n "$target" ]] && ! tx has-session -t "=$target" 2>/dev/null; then
    echo "error: no such workspace: $target" >&2
    exit 1
  fi
  if in_fleet_tmux; then
    [[ -n "$target" ]] && tx switch-client -t "=$target"
    return 0
  fi
  if [[ -n "${TMUX:-}" ]]; then
    echo "error: you're inside a different tmux server — detach first" >&2
    exit 1
  fi
  if [[ -n "$target" ]]; then
    exec "$TMUX_BIN" -L "$SOCKET" -f "$CONF" attach-session -t "=$target"
  else
    exec "$TMUX_BIN" -L "$SOCKET" -f "$CONF" attach-session
  fi
}

cmd_kill() {
  local target="${1:?usage: agent-fleet kill <session> | <session>:<window> | <pane_id>}"
  if [[ "$target" == %* ]]; then
    tx kill-pane -t "$target" && echo "killed pane $target"
  elif [[ "$target" == *:* ]]; then
    tx kill-window -t "=$target" && echo "killed window $target"
  else
    tx kill-session -t "=$target" && echo "killed workspace $target"
  fi
}

cmd_list() {
  if ! server_up; then
    echo "(fleet not running)"
    return 0
  fi
  tx list-sessions -F '#{session_name}' 2>/dev/null | sort | while read -r sess; do
    printf '\033[1;33m%s\033[0m\n' "$sess"
    tx list-windows -t "$sess" -F '  #{window_index}  #{window_name}  #{pane_current_path}' 2>/dev/null
  done
}

# rename-workspace [<old>] <new> — rename a workspace (tmux session).
# With one arg, renames the current workspace (run from inside the fleet).
cmd_rename_workspace() {
  local old new
  if [[ $# -ge 2 ]]; then old="$1"; new="$2"
  elif [[ $# -eq 1 ]]; then new="$1"; old="$(current_session)"
  else echo "usage: agent-fleet rename-workspace [<old>] <new>" >&2; exit 2; fi
  [[ -n "$old" ]] || { echo "error: no current workspace — run inside the fleet or pass <old>" >&2; exit 1; }
  new="$(sanitize_name "$new")"
  [[ "$old" == "$new" ]] && return 0
  tx rename-session -t "=$old" "$new" || return 1
  # Agents named after the old workspace follow the rename.
  local wid wname tag
  while IFS='|' read -r wid wname tag; do
    [[ -n "$tag" && "$wname" == "$old" ]] && tx rename-window -t "$wid" "$new"
  done < <(tx list-windows -t "=$new" -F '#{window_id}|#{window_name}|#{@fleet-agent}' 2>/dev/null)
  echo "workspace '$old' → '$new'"
}

# rename-tab [<target>] <new> — rename a tab (tmux window). Spaces allowed.
# With one arg, renames the current tab (run from inside the fleet).
cmd_rename_tab() {
  local target new
  if [[ $# -ge 2 ]]; then target="$1"; new="$2"
  elif [[ $# -eq 1 ]]; then new="$1"; target="$(current_window)"
  else echo "usage: agent-fleet rename-tab [<session:window>] <new>" >&2; exit 2; fi
  [[ -n "$target" ]] || { echo "error: no current tab — run inside the fleet or pass <target>" >&2; exit 1; }
  tx rename-window -t "$target" "$new" && echo "tab → '$new'"
}

# move [<target>] --to <workspace> — move a tab (tmux window) to another
# workspace (session) on the fleet server.
#   <target>: a pane id (%id, resolved to the window that owns it — an agent
#             owns its window, so this moves that agent), a <session>:<window>,
#             or a window id (@id). Omitted -> the current tab (run inside fleet).
#   --to <workspace>: destination workspace; must already exist.
#   --focus: follow the tab to the destination (like `add --focus`).
# Same-server move only (every workspace lives on the one fleet socket, so this
# always applies). The pane id is server-global and unchanged by the move, so
# per-pane state files ($AF_CACHE_DIR/panes/*) follow the agent untouched.
usage_move() {
  cat <<EOF
Usage: agent-fleet move [<target>] --to <workspace> [options]

Move a tab (tmux window) to another workspace on the fleet server.

Target:
  %<pane-id>                A pane id — moves the window that owns it.
  <session>:<window>        An explicit tab.
  @<window-id>              A window id.
  (omitted)                 The current tab (run inside the fleet).

Options:
  --to <workspace>          Destination workspace (must already exist). Required.
  --focus                   Follow the tab to the destination workspace.
  -h, --help                Show this help.
EOF
}

cmd_move() {
  local target="" dest="" focus=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)  usage_move; return 0 ;;
      --to)       dest="$2"; shift 2 ;;
      --focus)    focus=1; shift ;;
      --)         shift; break ;;
      -*)         echo "error: unknown flag: $1" >&2; usage_move >&2; exit 2 ;;
      *)          if [[ -z "$target" ]]; then target="$1"; else echo "error: unexpected arg: $1" >&2; exit 2; fi; shift ;;
    esac
  done
  [[ -n "$dest" ]] || { echo "usage: agent-fleet move [<target>] --to <workspace> [--focus]" >&2; exit 2; }
  server_up || { echo "error: no fleet running" >&2; exit 1; }

  # Resolve <target> to a window id (@id): server-global and stable across the
  # move, so the same handle drives both move-window and the post-move select.
  # Moving a window moves every pane in it (an agent plus any sidecar splits
  # travel together).
  local ref win=""
  if [[ -z "$target" ]]; then
    win="$(current_window)"
    [[ -n "$win" ]] || { echo "error: no current tab — run inside the fleet or pass <target>" >&2; exit 1; }
  else
    case "$target" in
      %*)  ref="$target" ;;      # pane id -> its window
      *:*) ref="=$target" ;;     # session:window — '=' exact-matches the session
      *)   ref="$target" ;;      # @window-id
    esac
    win="$(tx display-message -p -t "$ref" '#{window_id}' 2>/dev/null || true)"
    [[ -n "$win" ]] || { echo "error: no such tab: $target" >&2; exit 1; }
  fi

  tx has-session -t "=$dest" 2>/dev/null \
    || { echo "error: no such workspace: $dest (create it with connect / add --new-workspace)" >&2; exit 1; }

  # Trailing ':' with no index -> tmux appends at the next free index (no collision).
  tx move-window -s "$win" -t "=$dest:" || { echo "error: move failed" >&2; exit 1; }

  # Follow the tab, mirroring `add --focus`: switch workspace first (in-fleet),
  # then select the moved window in its new home.
  if [[ -n "$focus" ]] && in_fleet_tmux; then
    tx switch-client -t "=$dest" 2>/dev/null || true
    tx select-window -t "$win" 2>/dev/null || true
  fi
  echo "tab moved to workspace '$dest'"
}

# hooks-file — regenerate and print the path to the fleet's Claude settings
# overlay (hooks only). Useful for inspection or `claude --settings $(…)`.
cmd_hooks_file() {
  ensure_hook_settings
  echo
}

cmd_stop() {
  if ! server_up; then
    echo "fleet already stopped"
    return 0
  fi
  # Save the layout first so `agent-fleet attach` can rebuild it later.
  "$ROOT_DIR/scripts/persist-save.sh" 2>/dev/null || true
  local pf="$AF_CACHE_DIR/snapshotd.lock/pid" dpid
  # Comm-check before killing (same as the launchers): after an unclean
  # shutdown the pidfile can name a recycled, unrelated process. `|| true`
  # keeps set -e from aborting before kill-server on any failure here.
  dpid="$(cat "$pf" 2>/dev/null || true)"
  { [[ -n "$dpid" ]] && ps -p "$dpid" -o command= 2>/dev/null | grep -q snapshotd \
      && kill "$dpid" 2>/dev/null; } || true
  stop_remote_pollers
  legacy_daemon_sweep
  tx kill-server
  echo "fleet stopped"
}

# uninstall [-y|--yes] [--purge] — stop the fleet and remove the install.
# Unlinks the CLI from PATH, kills the server + snapshot daemon, and clears the
# state cache. The managed tree (the curl installer's $XDG_DATA_HOME/agent-fleet)
# is removed; a dev checkout is NEVER deleted (guarded by .git / a non-managed
# root), so uninstall can't nuke your working copy. --purge also drops the
# config dir. Destructive, so it confirms unless -y is given.
usage_uninstall() {
  cat <<EOF
Usage: agent-fleet uninstall [-y|--yes] [--purge]

Stop the fleet and remove the install: unlink the CLI, kill the server and the
snapshot daemon, and clear the state cache ($AF_CACHE_DIR).

A managed install (\$XDG_DATA_HOME/agent-fleet, from the curl installer) has its
tree removed; a dev checkout is left untouched. --purge also removes the config
dir (${XDG_CONFIG_HOME:-\$HOME/.config}/agent-fleet: theme choice + local.conf).

Options:
  -y, --yes     Don't prompt for confirmation.
  --purge       Also remove the config dir.
  -h, --help    Show this help.
EOF
}

# Canonicalize a path by following symlinks (macOS has no readlink -f).
_canon() {
  local p="$1" d
  while [[ -L "$p" ]]; do d="$(cd "$(dirname "$p")" && pwd)"; p="$(readlink "$p")"; [[ "$p" != /* ]] && p="$d/$p"; done
  [[ -e "$p" ]] && printf '%s' "$(cd "$(dirname "$p")" && pwd)/$(basename "$p")"
}

# Ask "<msg> [y/N]" on stdin. 0=yes, 1=no/abort, 2=not interactive (caller
# should tell the user to pass -y). Callers must guard against set -e, e.g.
#   rc=0; _confirm "…" || rc=$?
#
# Deliberately only reads stdin. An earlier version fell back to opening
# /dev/tty when stdin wasn't a terminal: on a process orphaned off a dead pane
# that open() doesn't fail, it sleeps forever in the kernel holding a
# device-node lock, and every terminal on the machine hangs behind it. Prompting
# through a redirected stdin is a nicety; -y already covers that case.
_confirm() {
  [[ -t 0 ]] || return 2
  local ans=""
  read -r -p "$1 [y/N] " ans || ans=""
  case "$ans" in y|Y|yes|YES) return 0 ;; *) return 1 ;; esac
}

# _semver_gt A B — true iff version A > B. Tolerates a leading 'v'; missing or
# non-numeric fields count as 0. No dependency on `sort -V` (absent on BSD).
_semver_gt() {
  local i x y; local -a A B
  IFS=. read -r -a A <<<"${1#v}"
  IFS=. read -r -a B <<<"${2#v}"
  for i in 0 1 2; do
    x="${A[$i]:-0}"; x="${x//[!0-9]/}"; x="${x:-0}"
    y="${B[$i]:-0}"; y="${y//[!0-9]/}"; y="${y:-0}"
    (( 10#$x > 10#$y )) && return 0
    (( 10#$x < 10#$y )) && return 1
  done
  return 1   # equal -> not greater
}

# _latest_tag — print the highest vX.Y.Z tag published on GitHub (no jq needed).
# Reads $AGENT_FLEET_TAGS_URL when set (tests inject a fixture), else the API.
_latest_tag() {
  local url="${AGENT_FLEET_TAGS_URL:-https://api.github.com/repos/$AGENT_FLEET_REPO/tags}"
  local body best="" t
  body="$(curl -fsSL --max-time 10 "$url" 2>/dev/null)" || return 1
  while IFS= read -r t; do
    [[ "$t" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+$ ]] || continue
    { [[ -z "$best" ]] || _semver_gt "$t" "$best"; } && best="$t"
  done < <(printf '%s\n' "$body" \
             | grep -oE '"name"[[:space:]]*:[[:space:]]*"[^"]+"' \
             | sed -E 's/.*"([^"]+)"$/\1/')
  [[ -n "$best" ]] && printf '%s' "$best"
}

cmd_uninstall() {
  local yes="" purge=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -y|--yes)  yes=1; shift ;;
      --purge)   purge=1; shift ;;
      -h|--help) usage_uninstall; return 0 ;;
      *) echo "error: unexpected arg: $1" >&2; usage_uninstall >&2; exit 2 ;;
    esac
  done

  local data_dir="${XDG_DATA_HOME:-$HOME/.local/share}/agent-fleet"
  local cfg_dir="${XDG_CONFIG_HOME:-$HOME/.config}/agent-fleet"
  local real_cli="$BIN_DIR/agent-fleet"

  # Managed install (delete OK) vs dev checkout (never delete): the root must be
  # exactly the managed data dir AND carry no .git.
  local managed=0
  if [[ "$(_canon "$ROOT_DIR" || echo "$ROOT_DIR")" == "$(_canon "$data_dir" || echo "$data_dir")" && ! -d "$ROOT_DIR/.git" ]]; then
    managed=1
  fi

  # PATH symlinks (plus the usual install bins) that resolve to our real CLI —
  # both the full name and the `af` shortcut.
  local -a links=()
  local d nm cand
  while IFS= read -r d; do
    for nm in agent-fleet af; do
      cand="$d/$nm"
      [[ -L "$cand" ]] || continue
      [[ "$(_canon "$cand" 2>/dev/null)" == "$real_cli" ]] && links+=("$cand")
    done
  done < <(printf '%s\n' "${PATH//:/$'\n'}" "$HOME/.local/bin" "/usr/local/bin" | awk 'NF && !seen[$0]++')

  # --- plan + confirm (destructive) ---
  echo "agent-fleet uninstall will:"
  echo "  • stop the fleet server + snapshot daemon"
  if ((${#links[@]})); then printf '  • unlink CLI: %s\n' "${links[@]}"; else echo "  • (no CLI symlink found on PATH)"; fi
  echo "  • clear state cache: $AF_CACHE_DIR"
  if ((managed)); then echo "  • remove install tree: $ROOT_DIR"
  else echo "  • KEEP source tree (dev checkout): $ROOT_DIR"; fi
  [[ -n "$purge" ]] && echo "  • remove config: $cfg_dir"
  echo
  if [[ -z "$yes" ]]; then
    local rc=0; _confirm "proceed?" || rc=$?
    case $rc in
      0) ;;
      2) echo "refusing to uninstall without a TTY — re-run with -y to confirm" >&2; exit 1 ;;
      *) echo "aborted."; return 0 ;;
    esac
  fi

  # --- stop the fleet (comm-checked daemon kill, then server) ---
  if server_up; then
    local pf="$AF_CACHE_DIR/snapshotd.lock/pid" dpid
    dpid="$(cat "$pf" 2>/dev/null || true)"
    { [[ -n "$dpid" ]] && ps -p "$dpid" -o command= 2>/dev/null | grep -q snapshotd && kill "$dpid" 2>/dev/null; } || true
    tx kill-server 2>/dev/null || true
    echo "stopped the fleet."
  fi
  # Unconditional: a poller outlives the server it was started for.
  stop_remote_pollers
  legacy_daemon_sweep

  # --- unlink, clear state, optional config, then the managed tree last ---
  # The whole cache ROOT goes: every socket's scoped dir, the shared
  # theme.conf, and any pre-scoping leftovers — uninstall leaves nothing.
  local l
  if ((${#links[@]})); then for l in "${links[@]}"; do rm -f "$l" && echo "unlinked: $l"; done; fi
  [[ -d "$AF_CACHE_ROOT" ]] && rm -rf "$AF_CACHE_ROOT" && echo "cleared: $AF_CACHE_ROOT"
  [[ -n "$purge" && -d "$cfg_dir" ]] && rm -rf "$cfg_dir" && echo "removed: $cfg_dir"
  if ((managed)); then
    rm -rf "$ROOT_DIR" && echo "removed: $ROOT_DIR"
    echo "uninstalled."
  else
    echo "kept source tree: $ROOT_DIR (delete the checkout yourself if you're done with it)"
    echo "uninstalled."
  fi
}

# upgrade [--check] [--rollback] [-y] — self-update a managed install to the
# newest published tag, keeping one .prev backup for rollback. Dev checkouts
# and Nix installs are detected and pointed at their own update path (git / nix)
# rather than touched. Reloads the running fleet so new code takes effect live.
usage_upgrade() {
  cat <<EOF
Usage: agent-fleet upgrade [--check] [--rollback] [-y|--yes]

Update a managed install (from the curl installer) to the newest vX.Y.Z tag,
comparing against the installed version ($AGENT_FLEET_VERSION). The previous
tree is kept as <install>.prev for one-step rollback.

  --check       Report installed vs latest and exit (no changes).
  --rollback    Restore the previous version from the .prev backup.
  -y, --yes     Don't prompt for confirmation.
  -h, --help    Show this help.

A dev checkout (git) or Nix install is not modified — upgrade prints the right
command instead. AGENT_FLEET_REF=<tag|sha> forces a specific ref (pin/downgrade).
EOF
}

cmd_upgrade() {
  local check="" rollback="" yes="" force_ref="${AGENT_FLEET_REF:-}"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --check)    check=1; shift ;;
      --rollback) rollback=1; shift ;;
      -y|--yes)   yes=1; shift ;;
      -h|--help)  usage_upgrade; return 0 ;;
      *) echo "error: unexpected arg: $1" >&2; usage_upgrade >&2; exit 2 ;;
    esac
  done

  local data_dir="${XDG_DATA_HOME:-$HOME/.local/share}/agent-fleet"
  local prev_dir="$data_dir.prev"

  # --- install-type detection: only a managed tree is ours to swap ---
  case "$ROOT_DIR" in
    /nix/store/*)
      echo "installed via Nix — upgrade with:"
      echo "  nix profile upgrade agent-fleet     # or bump the flake input in your config"
      return 0 ;;
  esac
  local managed=0
  if [[ "$(_canon "$ROOT_DIR" || echo "$ROOT_DIR")" == "$(_canon "$data_dir" || echo "$data_dir")" && ! -d "$ROOT_DIR/.git" ]]; then
    managed=1
  fi
  if (( ! managed )); then
    echo "this is a dev checkout — upgrade with git:"
    echo "  git -C \"$ROOT_DIR\" pull --ff-only && agent-fleet reload"
    return 0
  fi

  # Reload the live fleet through the (post-swap) CLI so new code takes effect.
  _reload_live() {
    server_up || return 0
    if command -v agent-fleet >/dev/null 2>&1; then agent-fleet reload || true
    else "$data_dir/bin/agent-fleet" reload || true; fi
  }

  # --- rollback: swap current <-> .prev ---
  if [[ -n "$rollback" ]]; then
    [[ -d "$prev_dir" ]] || { echo "error: nothing to roll back to ($prev_dir missing)" >&2; exit 1; }
    local swap="$data_dir.swap.$$"
    rm -rf "$swap"
    # shellcheck disable=SC2015 # chained error trap, not if/then/else: any mv failing must hit the handler
    mv "$data_dir" "$swap" && mv "$prev_dir" "$data_dir" && mv "$swap" "$prev_dir" \
      || { echo "error: rollback swap failed" >&2; exit 1; }
    echo "rolled back to the previous version ($("$data_dir/bin/agent-fleet" --version 2>/dev/null || echo '?'))."
    _reload_live
    return 0
  fi

  # --- resolve latest published tag ---
  command -v curl >/dev/null 2>&1 || { echo "error: curl is required" >&2; exit 1; }
  local installed="$AGENT_FLEET_VERSION" latest
  latest="$(_latest_tag)" || { echo "error: could not fetch the tag list" >&2; exit 1; }
  [[ -n "$latest" ]] || { echo "error: no vX.Y.Z tags published yet" >&2; exit 1; }

  if [[ -n "$check" ]]; then
    echo "installed: $installed"
    echo "latest:    ${latest#v}"
    if [[ -n "$force_ref" ]]; then echo "→ AGENT_FLEET_REF=$force_ref set; upgrade would fetch that ref"
    elif _semver_gt "$latest" "$installed"; then echo "→ update available"
    else echo "→ up to date"; fi
    return 0
  fi

  # --- pick the ref to install ---
  local ref
  if [[ -n "$force_ref" ]]; then
    ref="$force_ref"
  elif _semver_gt "$latest" "$installed"; then
    ref="$latest"
  else
    echo "already up to date ($installed)."
    return 0
  fi

  if [[ -z "$yes" ]]; then
    local rc=0; _confirm "upgrade $installed → ${ref#v}?" || rc=$?
    case $rc in
      0) ;;
      2) echo "refusing to upgrade without a TTY — re-run with -y" >&2; exit 1 ;;
      *) echo "aborted."; return 0 ;;
    esac
  fi

  # --- download (AGENT_FLEET_TARBALL overrides the source, for tests) ---
  command -v tar >/dev/null 2>&1 || { echo "error: tar is required" >&2; exit 1; }
  local tmp url src; tmp="$(mktemp -d)"
  url="${AGENT_FLEET_TARBALL:-https://codeload.github.com/$AGENT_FLEET_REPO/tar.gz/$ref}"
  echo "downloading $ref …"
  curl -fsSL "$url" | tar -xzf - -C "$tmp" \
    || { rm -rf "$tmp"; echo "error: download/extract failed ($url)" >&2; exit 1; }
  src="$(find "$tmp" -maxdepth 1 -type d -name 'agent-fleet-*' | head -1)"
  [[ -n "$src" && -f "$src/bin/agent-fleet" ]] \
    || { rm -rf "$tmp"; echo "error: tarball did not contain bin/agent-fleet" >&2; exit 1; }
  chmod +x "$src/bin/agent-fleet" "$src"/scripts/*.sh "$src"/shims/* 2>/dev/null || true

  # --- rotate: current -> .prev, new -> current (atomic mv; running process
  #     keeps its open inode, so this can safely replace our own tree) ---
  rm -rf "$prev_dir"
  mv "$data_dir" "$prev_dir" || { rm -rf "$tmp"; echo "error: could not back up the current install" >&2; exit 1; }
  if ! mv "$src" "$data_dir"; then
    mv "$prev_dir" "$data_dir" 2>/dev/null || true
    rm -rf "$tmp"; echo "error: swap failed — restored the previous version" >&2; exit 1
  fi
  rm -rf "$tmp"
  echo "upgraded $installed → ${ref#v}."
  _reload_live
  echo "rollback if needed:  agent-fleet upgrade --rollback"
}

# Shared machinery for install-wide agent hook blocks (kimi, codex). These
# CLIs load hooks only from their global config — no per-launch overlay flag
# like claude's --settings — so this is explicit opt-in state on the user's
# machine: a fenced, marked block, idempotent install, clean remove. The hook
# script itself no-ops outside fleet panes (TMUX_PANE gate), so non-fleet runs
# are unaffected. Block body arrives on stdin (install only).
_AF_BLK_BEGIN="# >>> agent-fleet hooks >>>"
_AF_BLK_END="# <<< agent-fleet hooks <<<"
manage_hooks_block() {  # <tool> <conf> <install|remove|status> [post-install note]
  local tool="$1" conf="$2" sub="$3" note="${4:-}"
  local b="$_AF_BLK_BEGIN" e="$_AF_BLK_END" tmp="$conf.af.$$"
  case "$sub" in
    install)
      if [[ ! -f "$conf" ]]; then
        echo "error: $conf not found — run $tool once so it creates its config, then retry" >&2
        exit 1
      fi
      # Drop any previous fleet block first (idempotent; also migrates the
      # block when the repo path or socket changes), keep everything else.
      sed "/^$b\$/,/^$e\$/d" "$conf" > "$tmp" || { rm -f "$tmp"; exit 1; }
      # Guard against a config with no trailing newline — the block marker
      # must start its own line or remove's range match misses it.
      if [[ -s "$tmp" && "$(tail -c1 "$tmp")" != "" ]]; then echo >> "$tmp"; fi
      { printf '%s\n' "$b"; cat; printf '%s\n' "$e"; } >> "$tmp"
      mv "$tmp" "$conf" || { rm -f "$tmp"; exit 1; }
      echo "$tool hooks installed in $conf (remove with: agent-fleet $tool-hooks remove)"
      [[ -n "$note" ]] && echo "$note" || true
      ;;
    remove)
      [[ -f "$conf" ]] || { echo "nothing to remove ($conf not found)"; return 0; }
      if ! grep -qxF "$b" "$conf"; then echo "no fleet hooks block in $conf"; return 0; fi
      # shellcheck disable=SC2015 # chained error trap, not if/then/else: sed OR mv failing must hit the handler
      sed "/^$b\$/,/^$e\$/d" "$conf" > "$tmp" && mv "$tmp" "$conf" || { rm -f "$tmp"; exit 1; }
      echo "$tool hooks removed from $conf"
      ;;
    status)
      if [[ -f "$conf" ]] && grep -qxF "$b" "$conf"; then
        echo "installed ($conf)"
      else
        echo "not installed"
      fi
      ;;
    *) echo "usage: agent-fleet $tool-hooks [install|remove|status]" >&2; exit 2 ;;
  esac
}

# hermes-hooks — hermes' shell hooks in ~/.hermes/config.yaml. UNLIKE
# the TOML tiers there is NO fenced block: hermes re-serializes config.yaml
# through PyYAML on many ordinary actions ("allow permanently" at an approval,
# the model picker, `hermes update`), stripping every comment — a fence would
# not survive the first rewrite. Identity therefore lives in the DATA: each
# entry's command string carries agent-status-hook.sh, which is also exactly
# what hermes' consent allowlist keys on (event, command).
# Event map (source-verified, hermes v0.19.0): on_session_start -> start
# (identity only; does not fire on --resume), pre_llm_call + pre_tool_call ->
# working, pre_approval_request -> wait (observer — hermes ignores its
# output), on_session_end -> done (fires at every turn end: hermes' Stop).
# The status hook prints nothing on stdout, so the pre_tool_call handler can
# never emit a block decision. Hooks inherit the parent env (TMUX_PANE rides
# through) and read snake_case JSON with session_id on stdin — the same
# contract the hook already speaks.
hermes_hooks_yaml() {
  local hook="$ROOT_DIR/scripts/agent-status-hook.sh" ev st
  echo "hooks:"
  for ev in "on_session_start start" "pre_llm_call working" "pre_tool_call working" \
            "pre_approval_request wait" "on_session_end done"; do
    st="${ev##* }"; ev="${ev%% *}"
    printf '  %s:\n    - command: "%s %s %s hermes"\n      timeout: 10\n' \
      "$ev" "$hook" "$st" "$SOCKET"
  done
}

# Strip fleet-owned entries from a hermes config: drop each list item whose
# command mentions the status hook (plus its more-indented continuation
# lines), then any event key left without items, then a bare hooks: — all
# computed structurally, because a PyYAML rewrite may have changed quoting,
# key order, and indentation since install. Only the command string is
# stable identity. Emits the filtered config on stdout.
hermes_hooks_strip() {
  # The identity regex is built with -v so a single-quote char class can live
  # inside the single-quoted program: the hook path must be the command
  # values FIRST token (optionally PyYAML-quoted) — a user wrapper that only
  # passes our hook as an ARGUMENT must never be stripped.
  awk -v sq="'" '
    function ind(l,  n) { n = 0; while (substr(l, n + 1, 1) == " ") n++; return n }
    BEGIN {
      skip = -1
      pat = "-[[:space:]]*command:[[:space:]]*[\"" sq "]?[^ \"" sq "]*agent-status-hook\\.sh([\"" sq "]|[[:space:]]|$)"
    }
    {
      n = ind($0)
      if (skip >= 0) {
        if ($0 ~ /^[[:space:]]*$/ || n > skip) next
        skip = -1
      }
      if ($0 ~ pat) { skip = n; next }
      lines[++cnt] = $0
    }
    END {
      # The hooks: span on the FILTERED lines.
      hstart = 0; hend = 0
      for (i = 1; i <= cnt; i++) if (lines[i] ~ /^hooks:[[:space:]]*$/) { hstart = i; break }
      if (hstart) {
        hend = cnt
        for (i = hstart + 1; i <= cnt; i++) {
          if (lines[i] ~ /^[[:space:]]*$/) continue
          if (ind(lines[i]) == 0) { hend = i - 1; break }
        }
      }
      # Bottom-up: a key-only line inside the span (or hooks: itself) with no
      # kept child below it has lost everything — drop. A child is a deeper-
      # indented line, OR a "- " list item at the SAME indent: PyYAML dumps
      # block sequences at the parent keys own indent level. (No apostrophes
      # in these comments — the whole program sits in single quotes.)
      nextind = -1; nextitem = 0
      for (i = cnt; i >= 1; i--) {
        drop = 0
        if (hstart && i >= hstart && i <= hend \
            && lines[i] ~ /^[[:space:]]*[A-Za-z0-9_]+:[[:space:]]*(#.*)?$/) {
          n = ind(lines[i])
          if (!(nextind > n || (nextind == n && nextitem))) drop = 1
        }
        if (!drop) {
          keepflag[i] = 1
          if (lines[i] !~ /^[[:space:]]*$/) {
            nextind = ind(lines[i])
            nextitem = (lines[i] ~ /^[[:space:]]*-/) ? 1 : 0
          }
        }
      }
      for (i = 1; i <= cnt; i++) if (keepflag[i]) print lines[i]
    }
  ' "$1"
}

cmd_hermes_hooks() {
  local sub="${1:-install}"
  local conf="${HERMES_HOME:-$HOME/.hermes}/config.yaml"
  local tmp="$conf.af.$$"
  case "$sub" in
    status)
      if [[ -f "$conf" ]] && grep -q 'agent-status-hook.sh' "$conf"; then
        echo "installed ($conf)"
      else
        echo "not installed"
      fi
      return 0 ;;
    remove)
      [[ -f "$conf" ]] || { echo "nothing to remove ($conf not found)"; return 0; }
      grep -q 'agent-status-hook.sh' "$conf" || { echo "no fleet hooks in $conf"; return 0; }
      # shellcheck disable=SC2015 # chained error trap: strip OR mv failing must hit the handler
      hermes_hooks_strip "$conf" > "$tmp" && mv "$tmp" "$conf" || { rm -f "$tmp"; exit 1; }
      if grep -q 'agent-status-hook.sh' "$conf"; then
        echo "warning: some fleet entries survived (unexpected layout) — 'hermes hooks list' shows what's left" >&2
      fi
      echo "hermes hooks removed from $conf"
      return 0 ;;
    install) ;;
    *) echo "usage: agent-fleet hermes-hooks [install|remove|status]" >&2; exit 2 ;;
  esac
  if [[ ! -f "$conf" ]]; then
    echo "error: $conf not found — run hermes once so it creates its config, then retry" >&2
    exit 1
  fi
  # Idempotent re-install: strip our entries first (also migrates the block
  # when the repo path or socket changed).
  hermes_hooks_strip "$conf" > "$tmp" || { rm -f "$tmp"; exit 1; }
  # An EMPTY inline section (hooks: {} / hooks: null — PyYAML dumps an
  # emptied map that way) is absence, not foreign config: replace it.
  if grep -Eq '^hooks:[[:space:]]*(\{\}|null)[[:space:]]*$' "$tmp"; then
    # shellcheck disable=SC2015 # chained error trap: sed OR mv failing must hit the handler
    sed -E '/^hooks:[[:space:]]*(\{\}|null)[[:space:]]*$/d' "$tmp" > "$tmp.2" && mv "$tmp.2" "$tmp" \
      || { rm -f "$tmp" "$tmp.2"; exit 1; }
  fi
  if grep -Eq '^hooks:' "$tmp"; then
    # A hooks: section we don't own. Merging foreign YAML from bash risks
    # corrupting the user's config — refuse, print the entries to add by hand.
    rm -f "$tmp"
    echo "error: $conf already has a hooks: section — merge these entries into it yourself" >&2
    echo "(stale fleet entries? run: agent-fleet hermes-hooks remove first):" >&2
    hermes_hooks_yaml >&2
    exit 1
  fi
  if [[ -s "$tmp" && "$(tail -c1 "$tmp")" != "" ]]; then echo >> "$tmp"; fi
  if [[ -s "$tmp" && -n "$(tail -n1 "$tmp")" ]]; then echo >> "$tmp"; fi
  hermes_hooks_yaml >> "$tmp"
  mv "$tmp" "$conf" || { rm -f "$tmp"; exit 1; }
  echo "hermes hooks installed in $conf (remove with: agent-fleet hermes-hooks remove)"
  echo "note: hermes trust-gates shell hooks — these stay INERT until you approve each"
  echo "      (event, command) pair: hermes prompts at the next interactive session;"
  echo "      'hermes hooks list' shows pending/approved. Do NOT set hooks_auto_accept"
  echo "      unless you want every future hook trusted wholesale."
}

# kimi-hooks — kimi's flat [[hooks]] entries in ~/.kimi/config.toml.
# Events: UserPromptSubmit/PreToolUse/PermissionResult -> working,
# PermissionRequest -> wait, Stop -> done.
cmd_kimi_hooks() {
  local sub="${1:-install}" hook="$ROOT_DIR/scripts/agent-status-hook.sh" ev st
  if [[ "$sub" != "install" ]]; then
    manage_hooks_block kimi "$HOME/.kimi/config.toml" "$sub"
    return
  fi
  manage_hooks_block kimi "$HOME/.kimi/config.toml" install <<TOML
# Managed by agent-fleet — 'agent-fleet kimi-hooks remove' deletes this block.
# Maps kimi lifecycle events to fleet pane states; no-op outside fleet panes.
$(for ev in "UserPromptSubmit working" "PreToolUse working" "PermissionRequest wait" \
            "PermissionResult working" "Stop done"; do
    st="${ev##* }"; ev="${ev%% *}"
    printf '[[hooks]]\nevent = "%s"\ncommand = "'\''%s'\'' %s %s kimi"\ntimeout = 10\n\n' \
      "$ev" "$hook" "$st" "$SOCKET"
  done)
TOML
}

# codex-hooks — codex's nested [[hooks.<Event>]] matcher groups in
# ~/.codex/config.toml. Same state map as kimi, except codex has no
# PermissionResult event — PostToolUse covers back-to-working after an
# approval. Codex trust-gates non-managed hooks: they stay inert until
# approved once in codex's own startup hooks review (which records the
# trusted hash), so install alone changes nothing until the user says yes
# in codex. The status hook prints nothing to stdout, so the
# PermissionRequest handler never emits an allow/deny decision.
cmd_codex_hooks() {
  local sub="${1:-install}" hook="$ROOT_DIR/scripts/agent-status-hook.sh" ev st
  if [[ "$sub" != "install" ]]; then
    manage_hooks_block codex "$HOME/.codex/config.toml" "$sub"
    return
  fi
  manage_hooks_block codex "$HOME/.codex/config.toml" install \
    "note: codex trust-gates hooks — approve them once in the review codex shows at next start" <<TOML
# Managed by agent-fleet — 'agent-fleet codex-hooks remove' deletes this block.
# Maps codex lifecycle events to fleet pane states; no-op outside fleet panes.
$(for ev in "UserPromptSubmit working" "PreToolUse working" "PostToolUse working" \
            "PermissionRequest wait" "Stop done"; do
    st="${ev##* }"; ev="${ev%% *}"
    printf '[[hooks.%s]]\n[[hooks.%s.hooks]]\ntype = "command"\ncommand = "'\''%s'\'' %s %s codex"\ntimeout_sec = 10\n\n' \
      "$ev" "$ev" "$hook" "$st" "$SOCKET"
  done)
TOML
}

# opencode-hooks — opencode loads JS plugins, not shell-command hooks, so the
# fleet ships one wholly-OWNED plugin file (~/.config/opencode/plugins/
# agent-fleet.js) instead of a fenced config block; remove = delete the file
# (guarded by the generation marker so a user's own file is never touched).
# State map: chat.message/tool.execute.before -> working (the latter also
# recovers from wait after an approval), permission.ask -> wait (observe-only —
# output.status is never set, so the plugin can't influence decisions),
# session.status idle -> done. The plugin runs inside opencode's process, so
# it sees the pane's env and no-ops outside fleet tmux panes. NOTE: opencode
# has no codex-style trust gate — plugins execute at startup, so installing
# this IS consenting to run it; the file is small and readable on purpose.
cmd_opencode_hooks() {
  local sub="${1:-install}"
  local dir="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/plugins" f js
  f="$dir/agent-fleet.js"
  local marker="generated by agent-fleet"
  case "$sub" in
    install)
      mkdir -p "$dir" 2>/dev/null || { echo "error: cannot create $dir" >&2; exit 1; }
      js="$(cat <<'JS'
// generated by agent-fleet (opencode-hooks install) — do not edit.
// Reports this pane's agent state to the fleet (rail, picker, status bar,
// notifications) and records the session id for resume-after-reboot.
// Observe-only: permission decisions are never touched. Outside a fleet
// tmux pane every hook below is a no-op.
// Remove with: agent-fleet opencode-hooks remove
import { existsSync } from "node:fs"

const HOOK = "__AF_HOOK__"

export const AgentFleetStatus = async ({ $ }) => {
  const socket = process.env["AGENT_FLEET_SOCKET"] ?? "agent-fleet"
  const tmux = process.env["TMUX"] ?? ""
  const inFleet =
    !!process.env["TMUX_PANE"] &&
    (tmux.split(",")[0] ?? "").endsWith("/" + socket) &&
    existsSync(HOOK)
  if (!inFleet) return {}

  const report = (state, sessionID) => {
    const payload = JSON.stringify({ session_id: sessionID ?? "" })
    // fire-and-forget; the hook script exits in milliseconds
    $`printf '%s' ${payload} | bash ${HOOK} ${state} ${socket} opencode`
      .quiet()
      .nothrow()
      .catch(() => {})
  }

  return {
    "chat.message": async (input) => report("working", input.sessionID),
    "tool.execute.before": async (input) => report("working", input.sessionID),
    "permission.ask": async (input) => report("wait", input.sessionID),
    event: async ({ event }) => {
      if (event.type === "session.status" && event.properties?.status?.type === "idle")
        report("done", event.properties.sessionID)
      else if (event.type === "session.idle") // pre-session.status opencode
        report("done", event.properties?.sessionID)
    },
  }
}
JS
)"
      printf '%s\n' "${js//__AF_HOOK__/$ROOT_DIR/scripts/agent-status-hook.sh}" > "$f"
      echo "opencode hooks installed: $f (remove with: agent-fleet opencode-hooks remove)"
      command -v opencode >/dev/null 2>&1 \
        || echo "note: opencode not found on PATH — the plugin activates once it's installed"
      ;;
    remove)
      if [[ ! -f "$f" ]]; then echo "not installed"; return 0; fi
      if grep -q "$marker" "$f"; then
        rm -f "$f"; echo "removed $f"
      else
        echo "error: $f was not generated by agent-fleet — not touching it" >&2
        exit 1
      fi
      ;;
    status)
      if [[ -f "$f" ]] && grep -q "$marker" "$f"; then echo "installed ($f)"; else echo "not installed"; fi
      ;;
    *)
      echo "usage: agent-fleet opencode-hooks [install|remove|status]" >&2; exit 2 ;;
  esac
}

# reload — respawn the snapshot daemon and every rail so they pick up new code
# (e.g. after a git pull) without stopping the fleet. Agent panes are untouched.
# Needed because ensure_snapshotd only starts a daemon when none is alive: a
# live pre-pull daemon (and rails) would otherwise run stale code forever.
cmd_reload() {
  if ! server_up; then echo "fleet not running" >&2; exit 1; fi
  ensure_server_env
  local pf="$AF_CACHE_DIR/snapshotd.lock/pid" dpid
  # Comm-check before killing (same as `stop`): after an unclean shutdown the
  # pidfile can name a recycled, unrelated process.
  dpid="$(cat "$pf" 2>/dev/null || true)"
  { [[ -n "$dpid" ]] && ps -p "$dpid" -o command= 2>/dev/null | grep -q snapshotd \
      && kill "$dpid" 2>/dev/null; } || true
  # Reach daemons a PRE-SCOPING fleet left at the cache root too — without
  # this, the first post-upgrade reload starts a second snapshotd next to the
  # legacy one and orphans its ssh pollers.
  legacy_daemon_sweep
  # Let the old daemon's cleanup trap release the lock before relaunching, so
  # the new daemon doesn't lose the takeover race and exit as a duplicate.
  local i
  for i in $(seq 1 20); do [[ -d "$AF_CACHE_DIR/snapshotd.lock" ]] || break; sleep 0.1; done
  ensure_snapshotd
  # Pick up hosts added to (or removed from) the remotes config since boot.
  stop_stale_pollers
  ensure_remote_pollers
  # Respawn each existing rail in place (`show` = kill + recreate). Windows
  # with the rail hidden are left alone.
  local w
  while IFS= read -r w; do
    [[ -n "$w" ]] || continue
    "$ROOT_DIR/scripts/sidenav-toggle.sh" "$w" '' show
  done < <(tx list-panes -a -F '#{window_id} #{@fleet-sidenav}' 2>/dev/null \
             | awk '$2=="1"{print $1}' | sort -u)
  # Re-style the live server (theme.conf was regenerated above at CLI start) and
  # re-tune per-window border overrides — makes `agent-fleet theme <name>` a
  # live switch, no restart. Also picks up edited keybindings/options, the same
  # thing Prefix r does. The theme snippet is sourced explicitly: the conf's %if
  # expands from the SERVER's environment, which on a server booted before the
  # theme existed doesn't have $AGENT_FLEET_THEME_CONF yet.
  tx source-file "$CONF" 2>/dev/null || true
  if [[ -f "$AGENT_FLEET_THEME_CONF" ]]; then
    tx source-file "$AGENT_FLEET_THEME_CONF" 2>/dev/null || true
  fi
  "$ROOT_DIR/scripts/border-tune.sh" 2>/dev/null || true
  echo "fleet reloaded — config re-sourced, daemon and rails respawned (theme: $AF_THEME)"
}

# theme [name] — list presets, or persist + apply one. The choice lives in
# ~/.config/agent-fleet/theme so every future CLI call (including keybind-fired
# ones running in the server env) resolves the same palette.
cmd_theme() {
  local dir="$ROOT_DIR/conf/themes" cfg="${XDG_CONFIG_HOME:-$HOME/.config}/agent-fleet"
  local name="${1:-}" f n
  if [[ -z "$name" ]]; then
    for f in "$dir"/*.sh; do
      n="$(basename "$f" .sh)"
      if [[ "$n" == "$AF_THEME" ]]; then echo "* $n"; else echo "  $n"; fi
    done
    return 0
  fi
  if [[ ! -f "$dir/$name.sh" ]]; then
    echo "error: unknown theme '$name' — list them with: agent-fleet theme" >&2
    exit 1
  fi
  mkdir -p "$cfg" 2>/dev/null || true
  printf '%s\n' "$name" > "$cfg/theme"
  export AGENT_FLEET_THEME="$name"
  theme_resolve
  theme_write_conf
  if server_up; then
    cmd_reload
  else
    echo "theme: $name (fleet not running — applies on next boot)"
  fi
}

# config [path|edit] — show where config lives, or open your overrides file.
# The base config ships in the repo; personal overrides go in local.conf, which
# the base config sources last (so they win). This doesn't parse config — it's
# a tmux config file; `edit` just opens it in $EDITOR, scaffolding a template.
usage_config() {
  cat <<EOF
Usage: agent-fleet config [path|edit]

  path   (default) Print where config lives: base config, your overrides,
         theme choice, and the generated theme file.
  edit   Open your overrides (local.conf) in \$EDITOR, creating a template if
         it doesn't exist. Apply changes with: agent-fleet reload (or Prefix r).
EOF
}

cmd_config() {
  local cfg_dir="${XDG_CONFIG_HOME:-$HOME/.config}/agent-fleet"
  local local_conf="$cfg_dir/local.conf"
  case "${1:-path}" in
    -h|--help) usage_config; return 0 ;;
    path)
      local mark=""; [[ -f "$local_conf" ]] || mark="  (not created yet — run: agent-fleet config edit)"
      printf 'base config:    %s\n' "$CONF"
      printf 'your overrides: %s%s\n' "$local_conf" "$mark"
      printf 'theme choice:   %s\n' "$cfg_dir/theme"
      printf 'generated:      %s  (do not edit)\n' "${AGENT_FLEET_THEME_CONF:-$AF_CACHE_ROOT/theme.conf}"
      ;;
    edit)
      mkdir -p "$cfg_dir"
      if [[ ! -f "$local_conf" ]]; then
        cat > "$local_conf" <<'TMPL'
# agent-fleet overrides — tmux config, sourced last by the base config so these
# win. Apply changes with: agent-fleet reload  (or Prefix r).
#
# Examples:
#   set -g @fleet-sidenav-auto off              # don't auto-open the rail
#   bind -n C-Left previous-window              # your own keybinds
#   set -g status-style "bg=#222436,fg=#c8d3f5" # tweak styling
TMPL
        echo "created $local_conf"
      fi
      "${EDITOR:-vi}" "$local_conf"
      echo "saved — apply with: agent-fleet reload"
      ;;
    *) echo "error: unknown arg: $1" >&2; usage_config >&2; exit 2 ;;
  esac
}

# save — snapshot the current layout to the restore file (also done on a timer
# by the daemon and on `stop`).
cmd_save() {
  if ! server_up; then echo "fleet not running" >&2; exit 1; fi
  "$ROOT_DIR/scripts/persist-save.sh" && echo "layout saved"
}

# restore — rebuild the saved layout on a stopped fleet (attach does this
# automatically on a cold boot; this is the manual equivalent).
cmd_restore() {
  if server_up; then
    echo "error: fleet already running — stop it first (agent-fleet stop)" >&2
    exit 1
  fi
  if [[ ! -f "$AF_CACHE_DIR/fleet.state" ]]; then
    echo "nothing to restore" >&2; exit 1
  fi
  # Any other failure (e.g. the state belongs to another socket) is explained on
  # persist-restore's own stderr.
  if "$ROOT_DIR/scripts/persist-restore.sh"; then
    ensure_server_env; ensure_snapshotd
    echo "layout restored — attach with: agent-fleet attach"
  else
    exit 1
  fi
}

# task — intent-level verbs over agents. The create form goes from a prompt to
# a live INTERACTIVE agent in one step: resolve the repo's workspace, spawn a
# hooked claude with the prompt as its positional argument (a real TUI you can
# attach to mid-conversation — never a headless run), and record the intent.
# review — a done task's deliverable is a DIFF, not scrollback. Show the
# task's full delta vs its merge-base, then act: PR it, merge it locally, or
# send notes back into the still-live agent session. Interactive menu on a
# TTY with no action flag; flags make every action scriptable/testable.
usage_review() {
  cat <<EOF
Usage: agent-fleet review <task-id|%pane> [action]

Actions (default: show the diff, then an interactive menu on a TTY):
  --diff-only      Print the diff and exit.
  --pr             Push the task branch and open a PR (gh); mark done after merge.
  --merge          Merge the task branch into the repo's current branch; marks it merged.
  --clean          (with --merge) Atomic finish: after the merge, close the
                   task's pane and reclaim its worktree+branch — the whole
                   happy path in one verb. Guards still refuse dirty/unmerged.
  --send <notes>   Type the notes into the task's LIVE agent pane (returns it to work).
EOF
}

cmd_review() {
  local target="" action="" notes="" doclean=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --diff-only) action="diff"; shift ;;
      --pr)        action="pr"; shift ;;
      --merge)     action="merge"; shift ;;
      --clean)     doclean=1; shift ;;
      --send)      action="send"; notes="${2:?error: --send needs notes}"; shift 2 ;;
      -h|--help)   usage_review; return 0 ;;
      -*) echo "error: unexpected arg: $1" >&2; usage_review >&2; exit 2 ;;
      *)  target="$1"; shift ;;
    esac
  done
  if [[ -n "$doclean" && "$action" != "merge" ]]; then
    echo "error: --clean goes with --merge (atomic finish)" >&2; exit 2
  fi
  [[ -n "$target" ]] || { usage_review >&2; exit 2; }
  local tid
  tid="$(task_id_for "$target")" || exit 1
  task_record_get "$tid" || { echo "error: unreadable task record: $tid" >&2; exit 1; }
  if [[ -z "$TASK_WORKTREE" || ! -d "$TASK_WORKTREE" ]]; then
    echo "error: $tid has no live worktree — review works on isolated tasks (af task --isolated)" >&2
    exit 1
  fi
  local repo="$TASK_REPO" branch="$TASK_BRANCH" wt="$TASK_WORKTREE" mb=""
  if [[ -n "$repo" && -n "$branch" ]]; then
    mb="$(git -C "$repo" merge-base "$branch" HEAD 2>/dev/null || true)"
  fi

  # Context line: what and how big, before any diff scrolls by. Not on
  # --diff-only, whose output must stay scriptable.
  review_context() {
    local ahead="" ss="" dirty=""
    if [[ -n "$mb" ]]; then
      ahead="$(git -C "$wt" rev-list --count "$mb"..HEAD 2>/dev/null || true)"
      [[ "$ahead" == "0" ]] && ahead=""
      ss="$(git -C "$wt" diff --shortstat "$mb" 2>/dev/null || true)"
    else
      ss="$(git -C "$wt" diff --shortstat HEAD 2>/dev/null || true)"
    fi
    [[ -n "$(git -C "$wt" status --porcelain 2>/dev/null | head -1)" ]] && dirty=" · uncommitted*"
    echo "review $tid · ${branch:-?}${ahead:+ [$ahead ahead]} ·${ss:- no changes}$dirty"
    [[ -n "$TASK_INTENT" ]] && echo "intent: $TASK_INTENT" || true
    task_conflicts "$tid"   # overlapping live tasks, before you merge
    # task_conflicts iterates task_record_get — refill OUR task's globals
    # (review_pr titles from TASK_INTENT).
    task_record_get "$tid" || true
  }

  review_diff() {  # [color] — color only for the pager path; --diff-only
                   # output must stay scriptable (redirectable to a patch).
    local -a c=()
    if [[ "${1:-}" == "color" ]]; then c=(-c color.ui=always); fi
    if [[ -n "$mb" ]]; then
      git -C "$wt" "${c[@]}" diff "$mb"
    else
      git -C "$wt" "${c[@]}" diff HEAD
    fi
  }
  review_pager() {
    if command -v delta >/dev/null 2>&1; then delta --paging=always
    else less -R
    fi
  }
  review_pr() {
    command -v gh >/dev/null 2>&1 || { echo "error: gh not found — install GitHub CLI for --pr" >&2; return 1; }
    git -C "$wt" remote get-url origin >/dev/null 2>&1 \
      || { echo "error: no 'origin' remote — push the repo somewhere first" >&2; return 1; }
    local base; base="$(git -C "$repo" branch --show-current 2>/dev/null || true)"
    git -C "$wt" push -u origin "$branch" || return 1
    # --base: without it gh targets the remote DEFAULT branch, which may not
    # be the branch the diff was reviewed against.
    ( cd "$wt" && gh pr create --head "$branch" ${base:+--base "$base"} \
        --title "${TASK_INTENT:-$branch}" \
        --body "Task \`$tid\` via agent-fleet. Intent: ${TASK_INTENT:-—}" ) || return 1
    # An OPEN PR is not merged work: record a distinct, NON-terminal 'pr'
    # state — clean skips it, ls shows it, and nothing lies about the branch.
    local _now; printf -v _now '%(%s)T' -1
    printf 'state pr %s\n' "$_now" >> "$AF_TASKS_DIR/$tid" 2>/dev/null || true
    echo "PR open — when it merges: git -C $repo pull, then: agent-fleet task done $tid && agent-fleet task clean $tid"
  }
  review_merge() {
    local cur; cur="$(git -C "$repo" branch --show-current 2>/dev/null || true)"
    if [[ -z "$cur" ]]; then
      echo "error: $repo is on a detached HEAD — check out the merge target first" >&2; return 1
    fi
    echo "merging $branch into $cur"
    git -C "$repo" merge --no-edit "$branch" || {
      echo "error: merge failed — resolve in $repo by hand (nothing was marked)" >&2; return 1
    }
    task_mark "$tid" merged
  }
  review_send() {
    [[ -n "$notes" ]] || { echo "error: --send needs notes" >&2; return 1; }
    local rec_pane cur_tid
    rec_pane="$(awk '$1=="pane"{print $2; exit}' "$AF_TASKS_DIR/$tid" 2>/dev/null || true)"
    cur_tid="$(tx display-message -p -t "$rec_pane" '#{@fleet-task}' 2>/dev/null || true)"
    if [[ -z "$rec_pane" || "$cur_tid" != "$tid" ]]; then
      echo "error: the task's agent session is gone — send-back needs the LIVE pane (spawn a new task instead)" >&2
      return 1
    fi
    # A trailing ';' would be eaten by tmux argv parsing (see inbox.sh).
    [[ "$notes" == *';' ]] && notes="${notes%;}\;"
    tx send-keys -t "$rec_pane" -l -- "$notes" && tx send-keys -t "$rec_pane" Enter
    echo "sent to $rec_pane — the agent returns to working when it picks it up"
  }

  # Atomic finish: merge, then close the pane, then reclaim — the
  # order matters: task_clean's liveness guard refuses a live agent's
  # worktree, so the pane goes first (its work is merged; killing it loses
  # nothing). Any guard tripping stops the chain with its own message.
  review_finish() {
    # Pre-flight BEFORE anything irreversible: killing the pane is the one
    # step that cannot be undone, and task_clean commonly refuses a worktree
    # with uncommitted debris — that refusal must arrive with the agent still
    # alive to ask for cleanup.
    if [[ -n "$(git -C "$wt" status --porcelain 2>/dev/null | head -1)" ]]; then
      echo "error: worktree has uncommitted changes — finish refused (have the agent commit/clean them, or merge and 'task clean --force' yourself)" >&2
      return 1
    fi
    review_merge || return 1
    local rp cur others
    rp="$(awk '$1=="pane"{print $2; exit}' "$AF_TASKS_DIR/$tid" 2>/dev/null || true)"
    cur="$(tx display-message -p -t "$rp" '#{@fleet-task}' 2>/dev/null || true)"
    if [[ -n "$rp" && "$cur" == "$tid" ]]; then
      # Last non-rail pane in the window -> close the whole tab (a rail-only
      # window is a husk); otherwise just this pane.
      others="$(tx list-panes -t "$rp" -F '#{pane_id} #{?@fleet-sidenav,1,0}' 2>/dev/null | awk '$2 != "1"' | wc -l)"
      if (( others <= 1 )); then
        tx kill-window -t "$rp" 2>/dev/null || true
      else
        tx kill-pane -t "$rp" 2>/dev/null || true
      fi
    fi
    task_clean "$tid"
  }

  case "$action" in
    diff)  review_diff; return 0 ;;
    pr)    review_context; review_pr ;;
    merge) review_context
           if [[ -n "$doclean" ]]; then review_finish; else review_merge; fi ;;
    send)  review_send ;;
  esac
  if [[ -n "$action" ]]; then return 0; fi

  # No flag: context, diff through the pager, then (TTY only) the action menu.
  review_context
  review_diff color | review_pager || true
  [[ -t 0 ]] || return 0
  local choice="" _cur
  _cur="$(git -C "$repo" branch --show-current 2>/dev/null || true)"
  printf '\n[p] PR  [m] merge into %s  [M] merge + clean  [s] send back with notes  [q] quit: ' "${_cur:-HEAD}"
  IFS= read -r -n1 choice || choice=""
  printf '\n'
  case "$choice" in
    p) review_pr ;;
    m) review_merge ;;
    M) review_finish ;;
    s) printf 'notes: '; IFS= read -r notes; review_send ;;
    *) : ;;
  esac
}

usage_task() {
  cat <<EOF
Usage: agent-fleet task "<prompt>" [options]
       agent-fleet task -- "<prompt>" [options]   (force create — prompt may be a subcommand or -*)
       agent-fleet task ls
       agent-fleet task show <task-id|%pane>
       agent-fleet task adopt [%pane] ["intent"]
       agent-fleet task done|drop <task-id|%pane>
       agent-fleet task clean [<task-id|%pane>] [--dry-run] [--force] [--keep-branch]
       agent-fleet task history   (alias: agent-fleet history)

Spawn an interactive agent from an intent. Creates (or reuses) the workspace
for the target directory, starts a hooked $DEFAULT_AGENT_CMD agent with the
prompt submitted, and writes a task record that outlives the agent process.
Prints "<task-id> <pane-id>".

Options (create form):
  --repo <dir>   Directory to work in (default: current fleet pane's dir, else \$PWD).
  --name <name>  Agent/tab name (default: a slug of the prompt's first words).
  --isolation <rung>
                 host | worktree | sandbox | container — the isolation ladder,
                 each rung including the previous ones' guarantees. worktree =
                 branch af/task/<name> + a private worktree (parallel tasks on
                 one repo can't collide). sandbox = worktree + Claude Code's OS
                 bash sandbox (Seatbelt/bubblewrap), writes scoped to the
                 worktree, sandboxed bash auto-allowed. container = the agent
                 runs in Docker: the repo's devcontainer when present (with the
                 devcontainer CLI), else the default hardened image (af-default,
                 default-deny egress firewall) — worktree/.git/cache/~/.claude
                 mounted at identical paths, PTY in the pane.
                 Default: AGENT_FLEET_ISOLATION env > 'isolation <rung>' in
                 <repo>/.agent-fleet > ~/.config/agent-fleet/isolation > host.
                 Missing deps degrade one rung down, with a note.
  --isolated / --no-isolated
                 Legacy spellings of --isolation worktree / host.
                 (AGENT_FLEET_TASK_ISOLATED=1 still means worktree by default.)
  --focus        Jump to the new agent.
  -h, --help     Show this help.

'adopt' brings an EXISTING pane into the loop (hooked agents auto-adopt on
their first event; adopt covers panes whose agents are idle, or older panes).
Lifecycle: 'done' (merged) / 'drop' (abandoned) mark a task terminal; 'clean'
reclaims terminal tasks' worktrees and branches — refusing dirty trees and
unmerged branches unless --force. 'ls' shows [branch] with * dirty, ^ unmerged,
and lists orphaned worktrees. 'history' lists finished tasks (newest first,
grouped per day) with duration, total wait time, and outcome — merged /
abandoned / pr; abandoned~ marks an agent killed without an outcome.

Records live in $AF_TASKS_DIR; worktrees under $AF_WORKTREES_DIR.
EOF
}

# Empty states teach: name the command that fills them, never dead-end.
_no_tasks_hint()   { echo '(no tasks — spawn one: agent-fleet task "<prompt>", or adopt a pane: agent-fleet task adopt %pane)'; }
_no_history_hint() { echo '(no completed tasks — history fills as tasks reach done/drop; spawn one: agent-fleet task "<prompt>")'; }

task_ls() {
  [[ -d "$AF_TASKS_DIR" ]] || { _no_tasks_hint; return 0; }
  local f k v tid intent pane st mark any=""
  # Liveness = the pane exists AND is tagged with THIS task's id. Pane ids
  # restart at %0 every server generation, so a bare pane-exists check
  # false-matches recycled ids on records restore didn't re-link.
  local -A LIVE_T=()
  local lp lt
  if server_up; then
    while read -r lp lt; do
      [[ -n "$lp" && -n "$lt" ]] && LIVE_T[$lp]="$lt"
    done < <(tx list-panes -a -F '#{pane_id} #{@fleet-task}' 2>/dev/null)
  fi
  for f in "$AF_TASKS_DIR"/t*; do
    [[ -e "$f" ]] || continue
    case "$f" in *.tmp.*) continue ;; esac   # a crashed rewrite's leftover temp
    any=1; tid=""; intent=""; pane=""; st=""
    while read -r k v; do
      case "$k" in
        id)     tid="$v" ;;
        intent) intent="$v" ;;
        pane)   pane="$v" ;;
        state)  st="${v%% *}" ;;   # last one wins: current state
      esac
    done < "$f"
    # A dead pane means the agent is gone but the record (by design) is not.
    mark=" (gone)"
    if [[ -n "$pane" && "${LIVE_T[$pane]:-}" == "$tid" ]]; then mark=""; fi
    # Worktree column: branch plus * (dirty) / ^ (unmerged) — the two
    # signals clean's safety rails key on, surfaced before you reach for it.
    local wtcol=""
    task_record_get "$tid" || true
    if [[ -n "$TASK_BRANCH" ]]; then
      wtcol="  [$TASK_BRANCH"
      if [[ -d "$TASK_WORKTREE" ]] \
         && [[ -n "$(git -C "$TASK_WORKTREE" status --porcelain 2>/dev/null | head -1)" ]]; then
        wtcol+="*"
      fi
      if [[ -n "$TASK_REPO" ]] \
         && git -C "$TASK_REPO" show-ref --verify --quiet "refs/heads/$TASK_BRANCH" 2>/dev/null \
         && ! git -C "$TASK_REPO" merge-base --is-ancestor "$TASK_BRANCH" HEAD 2>/dev/null; then
        wtcol+="^"
      fi
      wtcol+="]"
    fi
    printf '%-18s %-9s %-6s%s%s  %s\n' "$tid" "${st:-idle}" "$pane" "$mark" "$wtcol" "$intent"
  done
  [[ -n "$any" ]] || _no_tasks_hint
  task_conflicts
  task_orphans
}

task_show() {
  local tid
  tid="$(task_id_for "${1:?usage: agent-fleet task show <task-id|%pane>}")" || exit 1
  cat "$AF_TASKS_DIR/$tid"
}

# Cross-task conflict warning: two live worktree tasks on one repo
# touching the same files merge painfully — surface the overlap before it
# hurts. On-demand only (task ls, review) — never the snapshot tick.
task_conflicts() {  # [tid] — restrict to pairs involving tid when given
  [[ -d "$AF_TASKS_DIR" ]] || return 0
  local f tid focus="${1:-}" pane mb flist
  local -a ctids=() crepos=() cfiles=()
  local -A LIVE_T=()
  local lp lt
  if server_up; then
    while read -r lp lt; do
      [[ -n "$lp" && -n "$lt" ]] && LIVE_T[$lp]="$lt"
    done < <(tx list-panes -a -F '#{pane_id} #{@fleet-task}' 2>/dev/null)
  fi
  for f in "$AF_TASKS_DIR"/t*; do
    [[ -e "$f" ]] || continue
    case "$f" in *.tmp.*) continue ;; esac
    tid="$(basename "$f")"
    task_record_get "$tid" || continue
    case "$TASK_STATE" in merged|abandoned|cleaned) continue ;; esac
    [[ -n "$TASK_WORKTREE" && -d "$TASK_WORKTREE" ]] || continue
    pane="$(awk '$1=="pane"{print $2; exit}' "$f" 2>/dev/null || true)"
    [[ -n "$pane" && "${LIVE_T[$pane]:-}" == "$tid" ]] || continue
    mb=""
    if [[ -n "$TASK_REPO" && -n "$TASK_BRANCH" ]]; then
      mb="$(git -C "$TASK_REPO" merge-base "$TASK_BRANCH" HEAD 2>/dev/null || true)"
    fi
    # Committed+staged (vs merge-base; when mb is unresolvable this degrades
    # to uncommitted-only) plus untracked files, one sorted set. ls-files, not
    # status --porcelain: porcelain quotes space paths and mangles renames,
    # which would corrupt the overlap compare.
    flist="$( { git -C "$TASK_WORKTREE" diff --name-only "${mb:-HEAD}" 2>/dev/null || true
                git -C "$TASK_WORKTREE" ls-files --others --exclude-standard 2>/dev/null || true
              } | sort -u )"
    [[ -n "$flist" ]] || continue
    ctids+=("$tid"); crepos+=("${TASK_REPO:-$TASK_WORKTREE}"); cfiles+=("$flist")
  done
  local i j overlap n first
  for (( i = 0; i < ${#ctids[@]}; i++ )); do
    for (( j = i + 1; j < ${#ctids[@]}; j++ )); do
      [[ "${crepos[$i]}" == "${crepos[$j]}" ]] || continue
      if [[ -n "$focus" && "$focus" != "${ctids[$i]}" && "$focus" != "${ctids[$j]}" ]]; then
        continue
      fi
      overlap="$(comm -12 <(printf '%s\n' "${cfiles[$i]}") <(printf '%s\n' "${cfiles[$j]}"))"
      [[ -n "$overlap" ]] || continue
      n="$(grep -c '' <<<"$overlap")"
      first="$(head -1 <<<"$overlap")"
      if (( n > 1 )); then
        echo "conflict risk: ${ctids[$i]} <-> ${ctids[$j]}: $first (+$(( n - 1 )) more)"
      else
        echo "conflict risk: ${ctids[$i]} <-> ${ctids[$j]}: $first"
      fi
    done
  done
}

# task adopt: bring an EXISTING pane into the record loop — history,
# review, and intent titles all key on records, and panes from before the
# record system (or hand-started agents) otherwise stay invisible forever.
task_adopt() {
  local pane="" intent=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      %*)        pane="$1"; shift ;;
      -h|--help) echo 'usage: agent-fleet task adopt [%pane] ["intent"]'; return 0 ;;
      *)         intent="$1"; shift ;;
    esac
  done
  if [[ -z "$pane" ]]; then
    if in_fleet_tmux && [[ -n "${TMUX_PANE:-}" ]]; then pane="$TMUX_PANE"; fi
    [[ -n "$pane" ]] || { echo "error: no pane — run inside the fleet or pass %pane" >&2; exit 2; }
  fi
  server_up || { echo "error: fleet not running" >&2; exit 1; }
  tx display-message -p -t "$pane" '#{pane_id}' >/dev/null 2>&1 \
    || { echo "error: no such pane: $pane" >&2; exit 1; }
  # Already in the loop? Either the pane option or the pointer file counts.
  local cur
  cur="$(tx display-message -p -t "$pane" '#{@fleet-task}' 2>/dev/null || true)"
  [[ -z "$cur" ]] && cur="$(cat "$AF_CACHE_DIR/panes/$pane.task" 2>/dev/null || true)"
  if [[ -n "$cur" && -f "$AF_TASKS_DIR/$cur" ]]; then
    echo "error: $pane already has task $cur" >&2; exit 1
  fi
  local dir kind wname
  dir="$(tx display-message -p -t "$pane" '#{pane_current_path}' 2>/dev/null || echo "$PWD")"
  kind="$(tx display-message -p -t "$pane" '#{@fleet-agent-kind}' 2>/dev/null || true)"
  wname="$(tx display-message -p -t "$pane" '#{window_name}' 2>/dev/null || true)"
  if [[ -z "$kind" ]]; then
    # Fall back to the running command, but only when it IS an agent —
    # adopting a plain shell records kind claude (what the pane will run).
    kind="$(tx display-message -p -t "$pane" '#{pane_current_command}' 2>/dev/null || true)"
    case "$kind" in
      claude|codex|opencode|kimi|hermes|agent) ;;
      *) kind="claude" ;;
    esac
  fi
  [[ -n "$intent" ]] || intent="${wname:-adopted}"
  local tid
  tid="$(task_record_create "$pane" "$intent" "$dir" "$kind")"
  [[ -n "$tid" ]] || { echo "error: record could not be written (cache unwritable?)" >&2; exit 1; }
  echo "adopted $pane -> $tid ($intent)"
}

# task_record_get <tid> — fill TASK_<FIELD> vars from a record (last one wins
# for every field — a container resume appends a new `container` line).
task_record_get() {
  local f="$AF_TASKS_DIR/$1" k v
  TASK_STATE=""; TASK_WORKTREE=""; TASK_BRANCH=""; TASK_REPO=""; TASK_INTENT=""
  TASK_DIR=""; TASK_SESSION=""
  [[ -f "$f" ]] || return 1
  while read -r k v; do
    case "$k" in
      state)     TASK_STATE="${v%% *}" ;;
      worktree)  TASK_WORKTREE="$v" ;;
      branch)    TASK_BRANCH="$v" ;;
      repo)      TASK_REPO="$v" ;;
      intent)    TASK_INTENT="$v" ;;   # PR titles (cmd_review)
      dir)       TASK_DIR="$v" ;;
      session)   TASK_SESSION="$v" ;;
    esac
  done < "$f"
  return 0
}

# task done|drop — terminal states. The review flow will call these;
# until then they're the explicit hand-off from "agent finished" to "worktree
# reclaimable".
task_mark() {  # <id|%pane> <merged|abandoned>
  local tid now
  tid="$(task_id_for "$1")" || exit 1
  # A cleaned task's worktree/branch are gone — resurrecting it would make
  # the next sweep reprocess a ghost (failed branch delete, bogus counts).
  task_record_get "$tid" || true
  if [[ "$TASK_STATE" == "cleaned" ]]; then
    echo "error: $tid is already cleaned — start a new task instead" >&2; exit 1
  fi
  printf -v now '%(%s)T' -1
  printf 'state %s %s\n' "$2" "$now" >> "$AF_TASKS_DIR/$tid" || exit 1
  echo "task $tid -> $2"
  # Container lifecycle: a terminal task's container has no reason to
  # keep running (its work lives in the mounted worktree).
  task_container_stop "$tid"
  if grep -q '^worktree ' "$AF_TASKS_DIR/$tid" 2>/dev/null; then
    echo "worktree recorded — reclaim it with: agent-fleet task clean $tid"
  fi
}

# task clean — reclaim worktrees/branches of TERMINAL tasks only.
# Safety is layered: `git worktree remove` itself refuses a dirty tree
# without --force, and we refuse an unmerged branch without --force — so
# unreviewed work is never eaten by a typo. --dry-run prints the plan.
task_clean() {
  local target="" dry="" force="" keepbr="" f tid now
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run)     dry=1; shift ;;
      --force)       force=1; shift ;;
      --keep-branch) keepbr=1; shift ;;
      -*) echo "error: unexpected arg: $1" >&2; exit 2 ;;
      *)  target="$1"; shift ;;
    esac
  done
  local -a tids=()
  if [[ -n "$target" ]]; then
    tid="$(task_id_for "$target")" || exit 1
    tids=("$tid")
  else
    for f in "$AF_TASKS_DIR"/t*; do
      [[ -e "$f" ]] || continue
      case "$f" in *.tmp.*) continue ;; esac
      tids+=("$(basename "$f")")
    done
  fi
  # Pane-liveness map (same discipline as task_ls): a task whose pane is
  # still running its agent is never swept out from under it without --force.
  local -A LIVE_T=()
  local lp lt
  if server_up; then
    while read -r lp lt; do
      if [[ -n "$lp" && -n "$lt" ]]; then LIVE_T[$lp]="$lt"; fi
    done < <(tx list-panes -a -F '#{pane_id} #{@fleet-task}' 2>/dev/null)
  fi
  local cleaned=0 skipped=0 failed=0 rec_pane
  for tid in ${tids[@]+"${tids[@]}"}; do
    task_record_get "$tid" || continue
    # State gate FIRST: "mark it terminal" is the actionable answer for a
    # non-terminal task, whether or not its agent is also still alive.
    case "$TASK_STATE" in
      merged|abandoned) ;;
      cleaned) continue ;;                      # already reclaimed
      *) # a named target deserves an explanation; the sweep stays quiet
         if [[ -n "$target" ]]; then
           echo "skip $tid: state '$TASK_STATE' is not terminal — mark it first (agent-fleet task done|drop $tid)"
           skipped=$(( skipped + 1 ))
         fi
         continue ;;
    esac
    rec_pane="$(awk '$1=="pane"{print $2; exit}' "$AF_TASKS_DIR/$tid" 2>/dev/null || true)"
    if [[ -z "$force" && -n "$rec_pane" && "${LIVE_T[$rec_pane]:-}" == "$tid" ]]; then
      echo "refuse $tid: its agent is still running in $rec_pane (kill it, or --force)"
      failed=$(( failed + 1 )); continue
    fi
    if [[ -z "$TASK_WORKTREE" ]]; then
      if [[ -n "$target" ]]; then
        echo "skip $tid: no worktree recorded"; skipped=$(( skipped + 1 ))
      fi
      continue
    fi
    local repo="${TASK_REPO:-}"
    if [[ -z "$repo" || ! -d "$repo" ]]; then
      echo "skip $tid: repo dir missing ($repo)"; skipped=$(( skipped + 1 )); continue
    fi
    # Unmerged commits are the "never eat unreviewed work" line: refuse
    # without --force regardless of merged/abandoned state.
    if [[ -n "$TASK_BRANCH" && -z "$force" ]] \
       && git -C "$repo" show-ref --verify --quiet "refs/heads/$TASK_BRANCH" 2>/dev/null \
       && ! git -C "$repo" merge-base --is-ancestor "$TASK_BRANCH" HEAD 2>/dev/null; then
      local _cur; _cur="$(git -C "$repo" branch --show-current 2>/dev/null || echo 'HEAD')"
      echo "refuse $tid: $TASK_BRANCH not merged into ${_cur:-HEAD} (merge it, check out the merge target, or --force)"
      failed=$(( failed + 1 )); continue
    fi
    if [[ -n "$dry" ]]; then
      echo "would remove: worktree $TASK_WORKTREE${keepbr:+ (keeping branch)}${TASK_BRANCH:+, branch $TASK_BRANCH}"
      continue
    fi
    if [[ -e "$TASK_WORKTREE" ]]; then
      if ! git -C "$repo" worktree remove ${force:+--force} "$TASK_WORKTREE" >/dev/null 2>&1; then
        echo "refuse $tid: worktree $TASK_WORKTREE not removable (dirty? --force to override)"
        failed=$(( failed + 1 )); continue
      fi
    else
      git -C "$repo" worktree prune >/dev/null 2>&1 || true
    fi
    if [[ -z "$keepbr" && -n "$TASK_BRANCH" ]]; then
      local delflag="-d"
      if [[ -n "$force" ]]; then delflag="-D"; fi
      git -C "$repo" branch "$delflag" "$TASK_BRANCH" >/dev/null 2>&1 \
        || echo "note: branch $TASK_BRANCH not deleted (unmerged? --force, or clean up by hand)"
    fi
    printf -v now '%(%s)T' -1
    printf 'state cleaned %s\n' "$now" >> "$AF_TASKS_DIR/$tid" 2>/dev/null || true
    task_container_stop "$tid"   # terminal marks stop it too; belt for kills
    echo "cleaned $tid: $TASK_WORKTREE"
    cleaned=$(( cleaned + 1 ))
  done
  if [[ -z "$dry" ]]; then echo "cleaned $cleaned, skipped $skipped, refused $failed"; fi
  # A failed reclaim exits nonzero so scripts notice; skips don't.
  (( failed == 0 )) || exit 1
  return 0
}

# Orphaned worktrees: dirs under the worktree root no task record points at
# (record deleted by hand, or a pre-record crash). Listed, never auto-removed.
task_orphans() {
  [[ -d "$AF_WORKTREES_DIR" ]] || return 0
  local -A KNOWN=()
  local f w any=""
  for f in "$AF_TASKS_DIR"/t*; do
    [[ -e "$f" ]] || continue
    w="$(awk '$1=="worktree"{sub(/^worktree /,""); print; exit}' "$f" 2>/dev/null || true)"
    if [[ -n "$w" ]]; then KNOWN[$w]=1; fi
  done
  for w in "$AF_WORKTREES_DIR"/*/*; do
    [[ -d "$w" ]] || continue
    if [[ -z "${KNOWN[$w]:-}" ]]; then
      [[ -n "$any" ]] || { echo "orphaned worktrees (no task record — remove with git worktree remove):"; any=1; }
      echo "  $w"
    fi
  done
}

# task history: what ran and what came of it, read entirely from task
# records — so it survives fleet restarts and reboots, and needs no server.
task_history() {
  [[ $# -eq 0 ]] || { echo "error: unexpected arg: $1 (task history takes none)" >&2; exit 2; }
  [[ -d "$AF_TASKS_DIR" ]] || { _no_history_hint; return 0; }
  # Liveness (same discipline as task_ls: pane exists AND is tagged with THIS
  # id — restore rewrites the record's pane line, so the key stays valid across
  # reboots). A non-terminal record with a dead pane was killed without an
  # outcome: history shows it as abandoned~ rather than losing it.
  local -A LIVE_T=()
  local lp lt
  if server_up; then
    while read -r lp lt; do
      [[ -n "$lp" && -n "$lt" ]] && LIVE_T[$lp]="$lt"
    done < <(tx list-panes -a -F '#{pane_id} #{@fleet-task}' 2>/dev/null)
  fi
  local f k v tid intent dir pane created
  local sname sepoch prev pepoch term tepoch prepoch postpr lastepoch
  local outcome ended wsum dur day wcol repob
  local -a rows=()
  local -A DAY_N=() DAY_M=()
  for f in "$AF_TASKS_DIR"/t*; do
    [[ -e "$f" ]] || continue
    case "$f" in *.tmp.*) continue ;; esac
    tid=""; intent=""; dir=""; pane=""; created=""
    prev=""; pepoch=0; term=""; tepoch=0; prepoch=0; postpr=""; lastepoch=0; wsum=0
    while read -r k v; do
      case "$k" in
        id)      tid="$v" ;;
        intent)  intent="$v" ;;
        dir)     dir="$v" ;;
        pane)    pane="$v" ;;
        created) created="$v" ;;
        state)
          sname="${v%% *}"; sepoch="${v##* }"
          [[ -z "$sepoch" || "$sepoch" == *[!0-9]* ]] && sepoch=0
          # Wait total: close the open wait at the NEXT transition. Restore
          # appends 'state idle' on reboot, so a straddling wait closes there.
          # A coerced-to-0 epoch (corrupt line) is unknown, not 1970 — never
          # let it open or close an interval.
          if [[ "$prev" == "wait" ]] && (( pepoch > 0 && sepoch > pepoch )); then
            wsum=$(( wsum + sepoch - pepoch ))
          fi
          prev="$sname"; pepoch="$sepoch"
          (( sepoch > lastepoch )) && lastepoch="$sepoch"
          # Outcome = the LAST merged/abandoned in the walk (task_mark can
          # re-mark). 'cleaned' is housekeeping, never the outcome; 'pr' is
          # an outcome only when nothing terminal ever landed. Activity AFTER
          # a pr (send-back resumed the agent) clears its finished-ness.
          case "$sname" in
            merged|abandoned) term="$sname"; tepoch="$sepoch" ;;
            pr)               prepoch="$sepoch"; postpr="" ;;
            working|wait)     postpr=1 ;;
          esac
          ;;
      esac
    done < "$f"
    [[ -n "$tid" ]] || continue
    [[ -z "$created" || "$created" == *[!0-9]* ]] && created=0
    if [[ -n "$term" ]]; then
      outcome="$term"; ended="$tepoch"
    elif (( prepoch > 0 )) && { [[ -z "$postpr" ]] || [[ "${LIVE_T[$pane]:-}" != "$tid" ]]; }; then
      # An open PR is the outcome — unless the agent resumed after it (send-
      # back) and is still alive: that's current work, not history.
      outcome="pr"; ended="$prepoch"
    elif [[ -n "$pane" && "${LIVE_T[$pane]:-}" == "$tid" ]]; then
      continue   # live and non-terminal: current work (task ls), not history
    else
      outcome="abandoned~"; ended="$lastepoch"
    fi
    # Corrupt outcome epochs coerce to 0: fall back to the best real signal
    # rather than filing the row under 1970-01-01.
    (( ended > 0 )) || ended="$lastepoch"
    (( ended > 0 )) || ended="$created"
    dur="-"
    if (( created > 0 && ended >= created )); then
      fmt_age "$(( ended - created ))"; dur="$AGE"
    fi
    wcol="-"
    if (( wsum > 0 )); then fmt_age "$wsum"; wcol="w:$AGE"; fi
    repob="${dir%/}"; repob="${repob##*/}"; [[ -n "$repob" ]] || repob="-"
    printf -v day '%(%Y-%m-%d)T' "$ended"
    DAY_N[$day]=$(( ${DAY_N[$day]:-0} + 1 ))
    [[ "$outcome" == "merged" ]] && DAY_M[$day]=$(( ${DAY_M[$day]:-0} + 1 ))
    rows+=("$(printf '%s\t%s\t  %-18s %-10s %5s %-6s %-14s %s' \
      "$ended" "$day" "$tid" "$outcome" "$dur" "$wcol" "$repob" "${intent:--}")")
  done
  (( ${#rows[@]} )) || { _no_history_hint; return 0; }
  local line lastday="" rday rrest
  while IFS= read -r line; do
    rday="${line#*$'\t'}"; rday="${rday%%$'\t'*}"
    rrest="${line#*$'\t'*$'\t'}"
    if [[ "$rday" != "$lastday" ]]; then
      printf '%s  %s tasks, %s merged\n' "$rday" "${DAY_N[$rday]}" "${DAY_M[$rday]:-0}"
      lastday="$rday"
    fi
    printf '%s\n' "$rrest"
  done < <(printf '%s\n' "${rows[@]}" | sort -s -t $'\t' -k1,1nr)
}

# _container-resume <tid> (internal): persist-restore points a restored
# container task's pane here. Rebuilds the container command from the record
# (fresh container name appended — last one wins), resumes the recorded claude
# session when one was captured, and execs it. Docker gone at boot → visible
# note + a shell (honest degrade; the record keeps saying container).
cmd_container_resume() {
  local tid="${1:?usage: agent-fleet _container-resume <task-id>}"
  task_record_get "$tid" || { echo "no task record for $tid — dropping to a shell" >&2; exec bash -i; }
  local dir="${TASK_DIR:-$PWD}"
  local repo="${TASK_REPO:-$dir}" wt="${TASK_WORKTREE:-}"
  # SECURITY: the task record is writable from INSIDE the container (the
  # cache is bind-mounted rw for the status hooks) and everything below ends
  # in host `bash -c`. Nothing record-sourced may reach it unvalidated — a
  # forged `session x; curl …` line would otherwise become host code at the
  # next reboot. Session ids are claude UUIDs; paths must be free of the
  # metacharacters that could escape the double-quoted ccmd embeds.
  if [[ -n "$TASK_SESSION" && ! "$TASK_SESSION" =~ ^[A-Za-z0-9-]+$ ]]; then
    echo "note: $tid's recorded session id is not a valid id — resuming fresh" >&2
    TASK_SESSION=""
  fi
  case "${dir}${repo}${wt}" in
    *[\"\$\`\\]*)
      echo "note: $tid's recorded paths contain shell metacharacters — dropping to a shell" >&2
      exec bash -i ;;
  esac
  if [[ ! -d "$dir" ]]; then
    echo "note: $tid's directory is gone (cleaned?) — dropping to a shell" >&2
    exec bash -i
  fi
  if ! container_available; then
    echo "note: docker is not available — $tid stays a shell (record still says container)" >&2
    exec bash -i
  fi
  local hooks_file tail
  hooks_file="$(ensure_hook_settings)"
  if [[ -n "$TASK_SESSION" ]]; then
    tail="claude --resume $TASK_SESSION --settings '$hooks_file'"
  else
    tail="claude --settings '$hooks_file'"
  fi
  build_container_cmd "resume-${tid}" "$dir" "$repo" "$wt" "$tail"
  if [[ -n "$CNAME" ]]; then
    printf 'container %s\n' "$CNAME" >> "$AF_TASKS_DIR/$tid" 2>/dev/null || true
  fi
  exec bash -c "$CCMD"
}

cmd_task() {
  # `task -- "<prompt>"` forces the create form — for scripted callers whose
  # prompt could collide with a subcommand ('ls', 'show') or start with '-'.
  local force_create=""
  [[ "${1:-}" == "--" ]] && { force_create=1; shift; }
  local sub="${1:-}"
  if [[ -z "$force_create" ]]; then
    case "$sub" in
      -h|--help) usage_task; return 0 ;;
      "")        usage_task >&2; exit 2 ;;
      ls)        shift; task_ls "$@"; return 0 ;;
      show)      shift; task_show "$@"; return 0 ;;
      adopt)     shift; task_adopt "$@"; return 0 ;;
      history)   shift; task_history "$@"; return 0 ;;
      done)      shift; task_mark "${1:?usage: agent-fleet task done <task-id|%pane>}" merged; return 0 ;;
      drop)      shift; task_mark "${1:?usage: agent-fleet task drop <task-id|%pane>}" abandoned; return 0 ;;
      clean)     shift; task_clean "$@"; return 0 ;;
      -*)        echo "error: the prompt comes first: agent-fleet task \"<prompt>\" [options] (or force it with --)" >&2; exit 2 ;;
    esac
  elif [[ -z "$sub" ]]; then
    usage_task >&2; exit 2
  fi

  local prompt="$1" dir="" name="" focus="" iso_flag=""
  shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo|--dir) dir="$2"; shift 2 ;;
      --name)       name="$2"; shift 2 ;;
      --focus)      focus=1; shift ;;
      --isolation)  iso_flag="${2:?usage: --isolation host|worktree|sandbox|container}"; shift 2 ;;
      --isolated)   iso_flag="worktree"; shift ;;   # legacy spelling of the rung
      --no-isolated) iso_flag="host"; shift ;;      # per-invocation opt-out of the env default
      *) echo "error: unexpected arg: $1" >&2; usage_task >&2; exit 2 ;;
    esac
  done

  if [[ -n "$dir" ]]; then
    [[ -d "$dir" ]] || { echo "error: no such directory: $dir" >&2; exit 1; }
    # CDPATH= : an exported CDPATH makes cd echo the resolved path, which the
    # substitution would capture as a doubled, newline-joined dir.
    dir="$(CDPATH='' cd -- "$dir" && pwd)"
  elif in_fleet_tmux && [[ -n "${TMUX_PANE:-}" ]]; then
    dir="$(tx display-message -p -t "$TMUX_PANE" '#{pane_current_path}' 2>/dev/null || echo "$PWD")"
    [[ -z "$dir" ]] && dir="$PWD"
  else
    dir="$PWD"
  fi

  # Default name: a slug of the prompt's first four words. read -ra, not a bare
  # word split — an unquoted $prompt would glob ("fix *.py" picks up files).
  if [[ -z "$name" ]]; then
    local w slug="" count=0
    local -a words=()
    read -ra words <<<"$prompt" || true
    for w in ${words[@]+"${words[@]}"}; do
      w="$(printf '%s' "$w" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9')"
      [[ -n "$w" ]] || continue
      slug+="${slug:+-}$w"
      count=$(( count + 1 )); (( count >= 4 )) && break
    done
    name="${slug:-task}"
  fi

  # Isolation ladder: resolve the rung, then degrade rung by rung with a
  # visible note wherever a dependency is missing — the record carries what
  # actually ran, never the intent.
  local rung
  rung="$(resolve_isolation "$dir" "$iso_flag")"
  if [[ "$rung" == "container" ]]; then
    if [[ "$(basename "${DEFAULT_AGENT_CMD%% *}")" != "claude" ]]; then
      echo "note: container rung is claude-only (agent: ${DEFAULT_AGENT_CMD%% *}) — degrading to sandbox" >&2
      rung="sandbox"
    elif ! container_available; then
      echo "note: docker is not available (CLI + running daemon needed) — degrading to sandbox" >&2
      rung="sandbox"
    fi
  fi
  if [[ "$rung" == "sandbox" ]]; then
    if [[ "$(basename "${DEFAULT_AGENT_CMD%% *}")" != "claude" ]]; then
      echo "note: sandbox rung is claude-only (agent: ${DEFAULT_AGENT_CMD%% *}) — degrading to worktree" >&2
      rung="worktree"
    elif ! sandbox_available; then
      echo "note: no OS sandbox on this host (Linux needs bubblewrap + socat) — degrading to worktree" >&2
      rung="worktree"
    fi
  fi

  # worktree rung: branch + worktree per task; the agent starts IN the
  # worktree. The workspace keeps the ORIGINAL repo's name (all of a repo's
  # tasks group under one workspace, isolated or not). Non-git dirs degrade
  # to the shared checkout, with a note.
  local repo_dir="$dir" wt="" wt_path="" wt_branch=""
  if [[ "$rung" == "worktree" || "$rung" == "sandbox" || "$rung" == "container" ]]; then
    wt="$(task_worktree_create "$dir" "$name")"
    if [[ -n "$wt" ]]; then
      wt_path="${wt%%$'\t'*}"; wt_branch="${wt#*$'\t'}"
      dir="$wt_path"
    else
      echo "note: $dir is not a git repo (or worktree add failed) — running in the shared checkout" >&2
      # A sandbox scoped to a shared checkout still sandboxes: keep the rung.
      [[ "$rung" == "worktree" ]] && rung="host"
    fi
  fi
  # A control char in the sandboxed root would make the overlay unparseable
  # JSON — and an unparseable overlay silently disables its own
  # failIfUnavailable backstop. Degrade visibly instead.
  if [[ "$rung" == "sandbox" && "$dir" == *[[:cntrl:]]* ]]; then
    echo "note: control characters in the task path can't ride in the sandbox overlay — degrading" >&2
    if [[ -n "$wt_path" ]]; then rung="worktree"; else rung="host"; fi
  fi

  ensure_server
  local ws pane
  ws="$(sanitize_name "$(basename "$repo_dir")")"
  # The prompt reaches the agent as "$AF_TASK_PROMPT", set on the window via
  # tmux -e (cmd_add --env) — it never passes through a shell parser, so no
  # quoting can mangle it. tmux runs window commands under default-shell, and
  # bash %q output broke there: fish rejects $'…' outright (the pane died while
  # `task` reported success) and dash passes it through literally. The plain
  # "$VAR" form below reads identically in every sh-family shell and fish.
  local add_args=(--to "$ws")
  tx has-session -t "=$ws" 2>/dev/null || add_args=(--new-workspace "$ws")
  # sandbox rung: the agent's bash may write only inside its cwd ($dir — the
  # worktree when one was created, else the shared checkout).
  [[ "$rung" == "sandbox" ]] && add_args+=(--sandbox "$dir")

  # container rung: the window command IS the container — the pane holds
  # its PTY directly (--rm -it), so attach shows the real TUI and killing the
  # pane reaps the container. Everything is mounted at IDENTICAL host paths:
  # the worktree (rw) plus the parent repo's .git (rw — the worktree's .git
  # file points there by absolute path, and the shared object store is the git
  # handback: commits land on the host branch instantly); the fleet cache (rw)
  # and scripts (ro) so the hooks overlay path stays valid inside and
  # agent-status-hook.sh writes states the host snapshotd reads as usual (its
  # tmux calls are command -v-guarded no-ops in there); ~/.claude (rw) for
  # credentials. -e VAR with no value passes the PANE's env through (TMUX_PANE,
  # AF_TASK_PROMPT, CLAUDE_CODE_OAUTH_TOKEN). NOTE the command string runs
  # under the user's default-shell — keep it fish/sh-compatible: no $( ), no
  # arrays, plain "quoted" expansions only.
  local ccmd="" cname="" cdir_rec=""
  if [[ "$rung" == "container" ]]; then
    local hooks_file
    hooks_file="$(ensure_hook_settings)"
    build_container_cmd "$name" "$dir" "$repo_dir" "$wt_path" \
      "claude --settings '$hooks_file' \"\$AF_TASK_PROMPT\""
    ccmd="$CCMD"; cname="$CNAME"; cdir_rec="$CDIR_REC"
  fi

  if [[ -n "$ccmd" ]]; then
    pane="$(cmd_add "$name" "${add_args[@]}" --dir "$dir" \
              --cmd "$ccmd" --kind claude \
              --env "AF_TASK_PROMPT=$prompt" --intent "$prompt" ${focus:+--focus})"
  else
    pane="$(cmd_add "$name" "${add_args[@]}" --dir "$dir" \
              --cmd "$DEFAULT_AGENT_CMD \"\$AF_TASK_PROMPT\"" \
              --env "AF_TASK_PROMPT=$prompt" --intent "$prompt" ${focus:+--focus})"
  fi
  # cmd_add ran in a command substitution, so recover the id from the pointer.
  # '-' rather than an empty field when the record could not be written: the
  # documented "<task-id> <pane-id>" output must stay two-field parseable.
  local tid=""
  tid="$(cat "$AF_CACHE_DIR/panes/$pane.task" 2>/dev/null || true)"
  if [[ -z "$tid" ]]; then
    echo "warning: task record could not be written (cache unwritable?) — the agent is running unrecorded" >&2
    tid="-"
  fi
  # Record the isolation facts so ls/clean can find the worktree later. The
  # record's `dir` line holds the worktree (the agent's cwd); `repo` holds the
  # original checkout — clean runs git against the repo, not the worktree.
  if [[ -n "$wt_path" && "$tid" != "-" && -f "$AF_TASKS_DIR/$tid" ]]; then
    # Same flatten invariant as task_record_create: a control char smuggled
    # into a value (repo comes from --repo) would forge record lines — e.g. a
    # fake 'state merged' that bypasses clean's terminal gate.
    {
      printf 'worktree %s\n' "${wt_path//[$'\n\r\t']/ }"
      printf 'branch %s\n'   "${wt_branch//[$'\n\r\t']/ }"
      printf 'repo %s\n'     "${repo_dir//[$'\n\r\t']/ }"
    } >> "$AF_TASKS_DIR/$tid" 2>/dev/null || true
  fi
  # The rung that actually ran (post-degrade), never the one asked for. The
  # sandboxfile line lets persist-restore relaunch with the same overlay; the
  # container line lets terminal marks stop the container.
  if [[ "$tid" != "-" && -f "$AF_TASKS_DIR/$tid" ]]; then
    {
      printf 'isolation %s\n' "$rung"
      [[ "$rung" == "sandbox" ]] && printf 'sandboxfile %s\n' "$(ensure_sandbox_settings "$dir")"
      [[ -n "$cname" ]] && printf 'container %s\n' "$cname"
      [[ -n "$cdir_rec" ]] && printf 'containerdir %s\n' "${cdir_rec//[$'\n\r\t']/ }"
    } >> "$AF_TASKS_DIR/$tid" 2>/dev/null || true
  fi
  echo "$tid $pane"
}

# pick — open the fzf popup (when called from inside the fleet), else attach.
cmd_pick() {
  ensure_server
  if in_fleet_tmux; then
    tx display-popup -E -w 85% -h 80% "$ROOT_DIR/scripts/pick.sh"
  else
    cmd_attach
  fi
}


usage() {
  cat <<EOF
agent-fleet — tmux-native session manager for Claude Code agents.   (alias: af)

Model:  workspace = tmux session   ·   agent = tmux window   ·   isolated socket

Verbs:
  agent-fleet connect <dir|name> [workspace-name]
                                   Resolve-or-create a workspace, then go to it. Optional name
                                   overrides the default (the directory's basename).
  agent-fleet attach [workspace]   Attach to the fleet (sesh-style 3-way branch).
  agent-fleet add [name] [--to <ws>] [--new-workspace <name>] [--cmd <cmd>] [--dir <dir>] [--focus]
                                   Add an agent window (default cmd: claude; hooks attach when the
                                   command is claude). --new-workspace puts it in its own workspace
                                   instead of a tab. --focus jumps to it (Prefix C). Prints its pane id.
  agent-fleet task "<prompt>" [--repo <dir>] [--name <name>] [--focus]
                                   Spawn an interactive agent from an intent: workspace resolved
                                   from the repo dir, prompt submitted at launch, intent recorded
                                   in a task record. Prints "<task-id> <pane-id>".
  agent-fleet task ls              List task records with their current state.
  agent-fleet task show <id|%pane> Print a task record (intent, dir, state history).
  agent-fleet task done|drop|clean Lifecycle: mark terminal, reclaim worktrees (see task -h).
  agent-fleet history              Finished tasks per day: duration, wait time, outcome (task history).
  agent-fleet review <id|%pane>    Diff a done task vs its base; PR / merge / send-back (see review -h).
  agent-fleet goto <pane_id>       Focus a specific agent pane (used by the picker).
  agent-fleet back                 Jump to the previously focused pane (bound to Prefix Tab).
  agent-fleet hooks-file           Print (and regenerate) the claude status-hooks overlay path.
  agent-fleet rename-workspace [<old>] <new>   Rename a workspace (session).
  agent-fleet rename-tab [<target>] <new>      Rename a tab (window).
  agent-fleet move [<target>] --to <ws> [--focus]
                                   Move a tab to another workspace. Target: %pane, <ws>:<win>,
                                   @window-id, or the current tab. --focus follows it there.
  agent-fleet kill <target>        Kill a workspace, window (<ws>:<win>), or pane (%id).
  agent-fleet list                 List workspaces and their agents.
  agent-fleet pick                 Open the fzf picker popup (or attach from a bare shell).
  agent-fleet kimi-hooks [install|remove|status]
                                   Manage the fleet status-hooks block in ~/.kimi/config.toml
                                   (kimi has no per-launch overlay; hooks are install-wide).
  agent-fleet codex-hooks [install|remove|status]
                                   Same for ~/.codex/config.toml. Codex trust-gates hooks:
                                   approve once in codex's startup hooks review to activate.
  agent-fleet opencode-hooks [install|remove|status]
                                   Manage the fleet status plugin at
                                   ~/.config/opencode/plugins/agent-fleet.js (opencode runs
                                   plugins at startup — no trust gate; the file is tiny, read it).
  agent-fleet hermes-hooks [install|remove|status]
                                   Manage the fleet shell-hook entries in ~/.hermes/config.yaml
                                   (data-anchored, no fence — hermes rewrites its config).
                                   Hermes trust-gates hooks: approve each pair at its next
                                   interactive session; 'hermes hooks list' shows status.
  agent-fleet reload               Re-source the config and respawn the snapshot daemon and rails (pick up new code/binds after a pull).
  agent-fleet theme [name]         List palettes, or switch to one live (persists in ~/.config/agent-fleet/theme).
  agent-fleet config [path|edit]   Show where config lives, or open your overrides (local.conf) in \$EDITOR.
  agent-fleet save                 Snapshot the layout to disk (also auto-saved + saved on stop).
  agent-fleet restore              Rebuild the saved layout on a stopped fleet (attach does this on boot).
  agent-fleet stop                 Save the layout, then kill the fleet server.
  agent-fleet uninstall [-y] [--purge]
                                   Stop the fleet, unlink the CLI, and clear state. Removes a managed
                                   install; never a dev checkout. --purge also drops the config dir.
  agent-fleet upgrade [--check] [--rollback] [-y]
                                   Update a managed install to the newest release tag (keeps one
                                   .prev for rollback). Dev/Nix installs get the right git/nix hint.

Env:
  AGENT_FLEET_CONF     Base tmux config (default: <repo>/conf/agent-fleet.conf)
  AGENT_FLEET_SOCKET   tmux socket name (default: agent-fleet)
  AGENT_FLEET_CMD      Default agent command (default: claude)
  AGENT_FLEET_THEME    One-shot palette override (normally use: agent-fleet theme <name>,
                       which persists; presets live in conf/themes/).
  AGENT_FLEET_ISOLATION
                       Default isolation rung for task (host|worktree|sandbox|container).
  AGENT_FLEET_RESTORE_ANY_SOCKET=1
                       Let restore rebuild a layout saved on a different socket. Off by
                       default so a one-off AGENT_FLEET_SOCKET can't clone the live fleet.
  AGENT_FLEET_REMOTES  Federated hosts (space/comma separated). Overrides the config file
                       ~/.config/agent-fleet/remotes. Their agents show up in the rail and
                       picker as <host>/<id>; ⏎ opens an ssh tab onto that agent.

User overrides: ~/.config/agent-fleet/local.conf is sourced by the base config if present.
EOF
}

main() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    connect|c)  cmd_connect "$@" ;;
    attach|a)   cmd_attach "$@" ;;
    add)        cmd_add "$@" ;;
    task)       cmd_task "$@" ;;
    history)    task_history "$@" ;;
    review)     cmd_review "$@" ;;
    goto)       cmd_goto "$@" ;;
    back)       cmd_back "$@" ;;
    rename-workspace|rename-ws) cmd_rename_workspace "$@" ;;
    rename-tab|rename-window)   cmd_rename_tab "$@" ;;
    move|mv)    cmd_move "$@" ;;
    kill|rm)    cmd_kill "$@" ;;
    list|ls)    cmd_list "$@" ;;
    pick)       cmd_pick "$@" ;;
    hooks-file) cmd_hooks_file "$@" ;;
    kimi-hooks)  cmd_kimi_hooks "$@" ;;
    hermes-hooks) cmd_hermes_hooks "$@" ;;
    codex-hooks) cmd_codex_hooks "$@" ;;
    opencode-hooks) cmd_opencode_hooks "$@" ;;
    reload)     cmd_reload "$@" ;;
    theme)      cmd_theme "$@" ;;
    config)     cmd_config "$@" ;;
    save)       cmd_save "$@" ;;
    restore)    cmd_restore "$@" ;;
    stop)       cmd_stop "$@" ;;
    uninstall)  cmd_uninstall "$@" ;;
    upgrade)    cmd_upgrade "$@" ;;
    # Internal: echo the last command-prompt input, parked in a tmux option by
    # the conf's prompt bindings (typed text never touches sh — see the conf).
    _prompt)    tx show-option -gqv @fleet-prompt 2>/dev/null ;;
    # Internal: restore's relaunch shim for container-rung tasks.
    _container-resume) cmd_container_resume "$@" ;;
    -V|--version|version) echo "agent-fleet $AGENT_FLEET_VERSION" ;;
    -h|--help|help) usage ;;
    "")         cmd_attach ;;
    *)          echo "unknown subcommand: $sub" >&2; usage; exit 2 ;;
  esac
}

main "$@"
